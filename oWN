			listPad.PaddingLeft = UDim.new(0, 6)
			listPad.PaddingRight = UDim.new(0, 6)
			listPad.Parent = list

			local open = false
			local objects = {}

			local function updateListSize()
				local count = 0
				for _, obj in ipairs(objects) do
					if obj.Parent then count += 1 end
				end
				local h = math.min(count * 34 + 12, 180)
				tween(list, {Size = UDim2.new(1, 0, 0, open and h or 0)}, options.tween_time)
			end

			main.MouseButton1Click:Connect(function()
				open = not open
				list.Visible = true
				updateListSize()
				if not open then
					task.delay(options.tween_time, function()
						if not open then list.Visible = false end
					end)
				end
			end)

			function dropdown_data:Add(n)
				local object_data = {}
				n = tostring(n or "Object")

				local opt = Instance.new("TextButton")
