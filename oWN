			valueLabel.BackgroundTransparency = 1
			valueLabel.AnchorPoint = Vector2.new(1, 0)
			valueLabel.Position = UDim2.new(1, -16, 0, 8)
			valueLabel.Size = UDim2.new(0, 80, 0, 20)
			valueLabel.Font = Enum.Font.GothamBlack
			valueLabel.Text = tostring(min)
			valueLabel.TextColor3 = accent
			valueLabel.TextSize = 14
			valueLabel.TextXAlignment = Enum.TextXAlignment.Right
			valueLabel.ZIndex = row.ZIndex + 1
			valueLabel.Parent = row

			local barBack = Instance.new("Frame")
			barBack.Position = UDim2.new(0, 16, 0, 42)
			barBack.Size = UDim2.new(1, -32, 0, 8)
			barBack.BackgroundColor3 = Color3.fromRGB(55, 58, 72)
			barBack.BorderSizePixel = 0
			barBack.ZIndex = row.ZIndex + 1
			barBack.Parent = row
			corner(barBack, 99)

			local barFill = Instance.new("Frame")
			barFill.Size = UDim2.new(0, 0, 1, 0)
			barFill.BackgroundColor3 = accent
			barFill.BorderSizePixel = 0
			barFill.ZIndex = row.ZIndex + 2
			barFill.Parent = barBack
			corner(barFill, 99)

			local held = false

			local function setValue(v)
				v = math.clamp(tonumber(v) or min, min, max)
				local pct = (v - min) / math.max(max - min, 1)
				valueLabel.Text = tostring(math.floor(v))
				tween(barFill, {Size = UDim2.new(pct, 0, 1, 0)}, options.tween_time)
				pcall(callback, math.floor(v))
			end

			function slider_data:Set(v)
				setValue(v)
			end

			barBack.InputBegan:Connect(function(input)
				if readonly then return end
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					held = true
				end
			end)

			UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					held = false
				end
			end)

			RunService.RenderStepped:Connect(function()
				if held and barBack.Parent then
					local mouseX = gMouse().X
					local pct = math.clamp((mouseX - barBack.AbsolutePosition.X) / barBack.AbsoluteSize.X, 0, 1)
					setValue(min + ((max - min) * pct))
				end
			end)

			setValue(min)
			return slider_data, row
		end

