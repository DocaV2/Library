	local tabButtons = Instance.new("Frame")
	tabButtons.Name = "TabButtons"
	tabButtons.BackgroundTransparency = 1
	tabButtons.Size = UDim2.new(1, 0, 1, 0)
	tabButtons.ZIndex = tabSelection.ZIndex + 1
	tabButtons.Parent = tabSelection

	local tabList = Instance.new("UIListLayout")
	tabList.FillDirection = Enum.FillDirection.Horizontal
	tabList.Padding = UDim.new(0, 4)
	tabList.SortOrder = Enum.SortOrder.LayoutOrder
	tabList.Parent = tabButtons

	local tabPad = Instance.new("UIPadding")
	tabPad.PaddingLeft = UDim.new(0, 4)
	tabPad.PaddingRight = UDim.new(0, 4)
	tabPad.PaddingTop = UDim.new(0, 4)
	tabPad.Parent = tabButtons

	local activeLine = Instance.new("Frame")
	activeLine.BackgroundColor3 = mainColor
	activeLine.BorderSizePixel = 0
	activeLine.Position = UDim2.new(0, 10, 0, 68)
	activeLine.Size = UDim2.new(1, -20, 0, 2)
	activeLine.ZIndex = window.ZIndex + 2
	activeLine.Parent = window

	local tabs = Instance.new("Frame")
	tabs.Name = "Tabs"
	tabs.BackgroundTransparency = 1
	tabs.Position = UDim2.new(0, 10, 0, 78)
	tabs.Size = UDim2.new(1, -20, 1, -88)
	tabs.ZIndex = window.ZIndex + 2
	tabs.Parent = window

	local resizer = Instance.new("TextLabel")
	resizer.Name = "Resizer"
	resizer.BackgroundTransparency = 1
	resizer.AnchorPoint = Vector2.new(1, 1)
	resizer.Position = UDim2.new(1, -2, 1, -2)
	resizer.Size = UDim2.new(0, 18, 0, 18)
	resizer.Font = Enum.Font.GothamBold
	resizer.Text = "⌟"
	resizer.TextColor3 = Theme.Muted
	resizer.TextSize = 16
	resizer.Active = true
	resizer.ZIndex = window.ZIndex + 10
	resizer.Parent = window

	dragify(window, bar)

	local resizing = false
	resizer.InputBegan:Connect(function(input)
		if canResize and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			resizing = true
		end
	end)

	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			resizing = false
		end
	end)

	RunService.RenderStepped:Connect(function()
		if resizing and window.Parent then
			local m = getMouse()
			local x = math.max(m.X - window.AbsolutePosition.X, minSize.X)
			local y = math.max(m.Y - window.AbsolutePosition.Y, minSize.Y)
			tween(window, {Size = UDim2.new(0, x, 0, y)}, tweenTime)
		end
	end)

	local open = true
	local oldHeight = minSize.Y

	toggle.MouseButton1Click:Connect(function()
		open = not open
		if open then
			tabSelection.Visible = true
			tabs.Visible = true
			activeLine.Visible = true
			resizer.Visible = true
			tween(window, {Size = UDim2.new(0, window.AbsoluteSize.X, 0, oldHeight)}, tweenTime)
			tween(toggle, {Rotation = 0}, tweenTime)
			toggle.Text = "▼"
		else
			oldHeight = window.AbsoluteSize.Y
			tabSelection.Visible = false
			tabs.Visible = false
			activeLine.Visible = false
			resizer.Visible = false
			tween(window, {Size = UDim2.new(0, window.AbsoluteSize.X, 0, 28)}, tweenTime)
			tween(toggle, {Rotation = -90}, tweenTime)
			toggle.Text = "▶"
		end
	end)

	close.MouseButton1Click:Connect(function()
		tween(window, {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1}, 0.15)
		task.delay(0.18, function()
			if window then window:Destroy() end
		end)
	end)

	local window_data = {
		Object = window,
		Tabs = {},
	}

	local function selectTab(tabData)
		for _, t in ipairs(window_data.Tabs) do
			local active = t == tabData
			t.Page.Visible = active
			t.Button.BackgroundColor3 = active and Color3.fromRGB(48, 51, 60) or Color3.fromRGB(38, 40, 48)
			t.Button.TextColor3 = active and Theme.White or Theme.Muted
		end
	end

	local function styleTabPage(page)
		local list = Instance.new("UIListLayout")
		list.Padding = UDim.new(0, 7)
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.Parent = page

		local pagePad = Instance.new("UIPadding")
		pagePad.PaddingTop = UDim.new(0, 2)
		pagePad.PaddingLeft = UDim.new(0, 1)
		pagePad.PaddingRight = UDim.new(0, 1)
		pagePad.Parent = page

		list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			page.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + 15)
		end)
	end

	function window_data:AddTab(tab_name)
		tab_name = tostring(tab_name or "New Tab")
		tabSelection.Visible = true

		local tabButton = Instance.new("TextButton")
		tabButton.Name = tab_name .. "_TabButton"
		tabButton.BackgroundColor3 = Color3.fromRGB(38, 40, 48)
		tabButton.BorderSizePixel = 0
		tabButton.Size = UDim2.new(0, math.max(68, textWidth(tab_name, 14) + 24), 0, 20)
		tabButton.Font = Enum.Font.GothamSemibold
		tabButton.Text = tab_name
		tabButton.TextColor3 = Theme.Muted
		tabButton.TextSize = 14
		tabButton.AutoButtonColor = false
		tabButton.ZIndex = tabButtons.ZIndex + 1
		tabButton.Parent = tabButtons
		corner(tabButton, 5)
		stroke(tabButton, Theme.Line, 0.8, 1)

		local page = Instance.new("ScrollingFrame")
		page.Name = tab_name .. "_Tab"
		page.BackgroundTransparency = 1
		page.BorderSizePixel = 0
		page.Size = UDim2.new(1, 0, 1, 0)
		page.CanvasSize = UDim2.new(0, 0, 0, 0)
		page.ScrollBarThickness = 4
		page.ScrollBarImageColor3 = mainColor
		page.ScrollBarImageTransparency = 0.15
		page.Visible = false
		page.ZIndex = tabs.ZIndex + 1
		page.Parent = tabs
		styleTabPage(page)

		local tab_data = {
			Button = tabButton,
			Page = page,
		}

		tabButton.MouseEnter:Connect(function()
			if not page.Visible then
				tween(tabButton, {BackgroundColor3 = Color3.fromRGB(45, 48, 56)}, tweenTime)
			end
		end)

		tabButton.MouseLeave:Connect(function()
			if not page.Visible then
				tween(tabButton, {BackgroundColor3 = Color3.fromRGB(38, 40, 48)}, tweenTime)
			end
		end)

		tabButton.MouseButton1Click:Connect(function()
			selectTab(tab_data)
		end)

		function tab_data:Show()
			selectTab(tab_data)
		end

		function tab_data:AddLabel(label_text)
			label_text = tostring(label_text or "New Label")

			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Size = UDim2.new(1, 0, 0, 22)
			label.Font = Enum.Font.GothamSemibold
			label.Text = label_text
			label.TextColor3 = Theme.Text
			label.TextSize = 14
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.ZIndex = page.ZIndex + 1
			label.Parent = page

			return label
		end

		function tab_data:AddButton(button_text, callback)
			button_text = tostring(button_text or "New Button")
			callback = typeof(callback) == "function" and callback or function() end

			local btn = Instance.new("TextButton")
			btn.BackgroundColor3 = mainColor
			btn.BorderSizePixel = 0
			btn.Size = UDim2.new(0, math.max(95, textWidth(button_text, 14) + 24), 0, 24)
			btn.Font = Enum.Font.GothamSemibold
			btn.Text = button_text
			btn.TextColor3 = Theme.White
			btn.TextSize = 14
			btn.AutoButtonColor = false
			btn.ClipsDescendants = true
			btn.ZIndex = page.ZIndex + 1
			btn.Parent = page
			corner(btn, 5)
			stroke(btn, mainColor:Lerp(Color3.new(1,1,1), 0.25), 0.65, 1)

			btn.MouseEnter:Connect(function()
				tween(btn, {BackgroundColor3 = mainColor:Lerp(Color3.new(1,1,1), 0.12)}, tweenTime)
			end)

			btn.MouseLeave:Connect(function()
				tween(btn, {BackgroundColor3 = mainColor}, tweenTime)
			end)

			btn.MouseButton1Click:Connect(function()
				ripple(btn)
				pcall(callback)
			end)

			return btn
		end

		function tab_data:AddSwitch(switch_text, callback)
			local switch_data = {}
			switch_text = tostring(switch_text or "New Switch")
			callback = typeof(callback) == "function" and callback or function() end

			local row = makeButtonBase(page, 28, page.ZIndex + 1)
			row.Size = UDim2.new(0, math.max(150, textWidth(switch_text, 14) + 60), 0, 28)

			local box = Instance.new("TextButton")
			box.BackgroundColor3 = Color3.fromRGB(47, 50, 58)
			box.BorderSizePixel = 0
			box.Position = UDim2.new(0, 5, 0.5, -9)
			box.Size = UDim2.new(0, 18, 0, 18)
			box.Font = Enum.Font.GothamBlack
			box.Text = ""
			box.TextColor3 = Theme.White
			box.TextSize = 14
			box.AutoButtonColor = false
			box.ZIndex = row.ZIndex + 1
			box.Parent = row
			corner(box, 4)
			stroke(box, Theme.Line, 0.6, 1)

			local title = Instance.new("TextLabel")
			title.BackgroundTransparency = 1
			title.Position = UDim2.new(0, 31, 0, 0)
			title.Size = UDim2.new(1, -36, 1, 0)
			title.Font = Enum.Font.GothamSemibold
			title.Text = switch_text
			title.TextColor3 = Theme.Text
			title.TextSize = 14
			title.TextXAlignment = Enum.TextXAlignment.Left
			title.ZIndex = row.ZIndex + 1
			title.Parent = row

			local toggled = false

			function switch_data:Set(bool)
				toggled = bool == true
				box.Text = toggled and "✓" or ""
				tween(box, {BackgroundColor3 = toggled and mainColor or Color3.fromRGB(47, 50, 58)}, tweenTime)
				pcall(callback, toggled)
			end

			box.MouseButton1Click:Connect(function()
				switch_data:Set(not toggled)
			end)

			row.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					switch_data:Set(not toggled)
				end
			end)

			return switch_data, row
		end

		function tab_data:AddTextBox(textbox_text, callback, textbox_options)
			textbox_text = tostring(textbox_text or "Input Text")
			callback = typeof(callback) == "function" and callback or function() end
			textbox_options = typeof(textbox_options) == "table" and textbox_options or {clear = true}

			local textbox = Instance.new("TextBox")
			textbox.BackgroundColor3 = Theme.Bg2
			textbox.BorderSizePixel = 0
			textbox.Size = UDim2.new(1, 0, 0, 26)
			textbox.Font = Enum.Font.GothamSemibold
