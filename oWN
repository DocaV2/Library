		for _, t in ipairs(window_data.Tabs) do
			local active = t == tabData
			t.Page.Visible = active
			t.Button:SetAttribute("Active", active)
			tween(t.Button, {BackgroundColor3 = active and Theme.Active or Theme.Card}, options.tween_time)
			local s = t.Button:FindFirstChildOfClass("UIStroke")
			if s then tween(s, {Transparency = active and 0.16 or 0.75}, options.tween_time) end
			local bar = t.Button:FindFirstChild("ActiveBar")
			if bar then tween(bar, {BackgroundTransparency = active and 0 or 1}, options.tween_time) end
		end
