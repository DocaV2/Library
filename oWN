			textbox.Parent = page
			corner(textbox, 5)
			stroke(textbox, Theme.Line, 0.68, 1)

			textbox.Focused:Connect(function()
				tween(textbox, {BackgroundColor3 = Theme.Bg3}, tweenTime)
			end)

			textbox.FocusLost:Connect(function(enter)
				tween(textbox, {BackgroundColor3 = Theme.Bg2}, tweenTime)
				if enter and #textbox.Text > 0 then
					pcall(callback, textbox.Text)
					if textbox_options.clear then
						textbox.Text = ""
					end
				end
			end)

			return textbox
		end

		function tab_data:AddSlider(slider_text, callback, slider_options)
			local slider_data = {}
			slider_text = tostring(slider_text or "New Slider")
			callback = typeof(callback) == "function" and callback or function() end
			slider_options = typeof(slider_options) == "table" and slider_options or {}
			local min = tonumber(slider_options.min) or 0
			local max = tonumber(slider_options.max) or 100
			local readonly = slider_options.readonly == true

			local holder = makeButtonBase(page, 38, page.ZIndex + 1)

			local title = Instance.new("TextLabel")
			title.BackgroundTransparency = 1
			title.Position = UDim2.new(0, 8, 0, 0)
			title.Size = UDim2.new(0.5, -8, 0, 20)
			title.Font = Enum.Font.GothamBold
			title.Text = slider_text
			title.TextColor3 = Theme.Text
			title.TextSize = 13
			title.TextXAlignment = Enum.TextXAlignment.Left
			title.ZIndex = holder.ZIndex + 1
			title.Parent = holder

			local value = Instance.new("TextLabel")
			value.BackgroundTransparency = 1
			value.AnchorPoint = Vector2.new(1, 0)
			value.Position = UDim2.new(1, -8, 0, 0)
			value.Size = UDim2.new(0, 70, 0, 20)
			value.Font = Enum.Font.GothamBold
			value.Text = tostring(min)
			value.TextColor3 = mainColor
			value.TextSize = 13
			value.TextXAlignment = Enum.TextXAlignment.Right
			value.ZIndex = holder.ZIndex + 1
			value.Parent = holder

			local back = Instance.new("Frame")
			back.BackgroundColor3 = Color3.fromRGB(50, 53, 62)
			back.BorderSizePixel = 0
			back.Position = UDim2.new(0, 8, 0, 25)
			back.Size = UDim2.new(1, -16, 0, 6)
			back.ZIndex = holder.ZIndex + 1
			back.Parent = holder
			corner(back, 99)

			local fill = Instance.new("Frame")
			fill.BackgroundColor3 = mainColor
			fill.BorderSizePixel = 0
			fill.Size = UDim2.new(0, 0, 1, 0)
			fill.ZIndex = holder.ZIndex + 2
			fill.Parent = back
			corner(fill, 99)

			local held = false

			local function setVal(v)
				v = math.clamp(tonumber(v) or min, min, max)
				local pct = (v - min) / math.max(max - min, 1)
				value.Text = tostring(math.floor(v))
				tween(fill, {Size = UDim2.new(pct, 0, 1, 0)}, tweenTime)
				pcall(callback, math.floor(v))
			end

			function slider_data:Set(v)
				setVal(v)
			end

			back.InputBegan:Connect(function(input)
				if readonly then return end
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					held = true
				end
			end)

			UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					held = false
				end
			end)

			RunService.RenderStepped:Connect(function()
				if held and back.Parent then
					local pct = math.clamp((getMouse().X - back.AbsolutePosition.X) / math.max(back.AbsoluteSize.X, 1), 0, 1)
					setVal(min + ((max - min) * pct))
				end
			end)

			setVal(min)
			return slider_data, holder
		end

		function tab_data:AddKeybind(keybind_name, callback, keybind_options)
			local keybind_data = {}
			keybind_name = tostring(keybind_name or "New Keybind")
			callback = typeof(callback) == "function" and callback or function() end
			keybind_options = typeof(keybind_options) == "table" and keybind_options or {}
			local current = keybind_options.standard or Enum.KeyCode.RightShift

			local row = makeButtonBase(page, 28, page.ZIndex + 1)

			local title = Instance.new("TextLabel")
			title.BackgroundTransparency = 1
			title.Position = UDim2.new(0, 8, 0, 0)
			title.Size = UDim2.new(1, -100, 1, 0)
			title.Font = Enum.Font.GothamSemibold
			title.Text = keybind_name
			title.TextColor3 = Theme.Text
			title.TextSize = 14
			title.TextXAlignment = Enum.TextXAlignment.Left
			title.ZIndex = row.ZIndex + 1
			title.Parent = row

			local bind = Instance.new("TextButton")
			bind.AnchorPoint = Vector2.new(1, 0.5)
			bind.Position = UDim2.new(1, -5, 0.5, 0)
			bind.Size = UDim2.new(0, 80, 0, 20)
			bind.BackgroundColor3 = Color3.fromRGB(47, 50, 58)
			bind.BorderSizePixel = 0
			bind.Font = Enum.Font.GothamBold
			bind.Text = current.Name
			bind.TextColor3 = mainColor
			bind.TextSize = 12
			bind.AutoButtonColor = false
			bind.ZIndex = row.ZIndex + 1
			bind.Parent = row
			corner(bind, 4)

			local binding = false

			function keybind_data:SetKeybind(key)
				if typeof(key) == "EnumItem" then
					current = key
					bind.Text = key.Name
				end
			end

			bind.MouseButton1Click:Connect(function()
				if binding then return end
				binding = true
				bind.Text = "..."
				local newInput = UIS.InputBegan:Wait()
				keybind_data:SetKeybind(newInput.KeyCode)
				binding = false
			end)

			UIS.InputBegan:Connect(function(input, gp)
				if not gp and not binding and input.KeyCode == current then
					pcall(callback, current)
				end
			end)

			return keybind_data, row
		end

		function tab_data:AddDropdown(dropdown_name, callback)
			local dropdown_data = {}
			dropdown_name = tostring(dropdown_name or "Dropdown")
			callback = typeof(callback) == "function" and callback or function() end

			local holder = makeButtonBase(page, 28, page.ZIndex + 1)

			local button = Instance.new("TextButton")
			button.BackgroundTransparency = 1
			button.Size = UDim2.new(1, 0, 1, 0)
			button.Font = Enum.Font.GothamBold
			button.Text = "  " .. dropdown_name
			button.TextColor3 = Theme.Text
			button.TextSize = 14
			button.TextXAlignment = Enum.TextXAlignment.Left
			button.AutoButtonColor = false
			button.ZIndex = holder.ZIndex + 1
			button.Parent = holder

			local arrow = Instance.new("TextLabel")
			arrow.BackgroundTransparency = 1
			arrow.AnchorPoint = Vector2.new(1, 0.5)
			arrow.Position = UDim2.new(1, -8, 0.5, 0)
			arrow.Size = UDim2.new(0, 20, 0, 20)
			arrow.Font = Enum.Font.GothamBlack
			arrow.Text = "▼"
			arrow.TextColor3 = mainColor
			arrow.TextSize = 12
			arrow.ZIndex = holder.ZIndex + 2
			arrow.Parent = holder

			local list = Instance.new("Frame")
			list.BackgroundColor3 = Theme.Bg2
			list.BorderSizePixel = 0
			list.Size = UDim2.new(1, 0, 0, 0)
			list.ClipsDescendants = true
			list.Visible = false
			list.ZIndex = page.ZIndex + 20
			list.Parent = page
			corner(list, 5)
			stroke(list, Theme.Line, 0.68, 1)

			local listLayout = Instance.new("UIListLayout")
			listLayout.SortOrder = Enum.SortOrder.LayoutOrder
			listLayout.Parent = list

			local items = {}
			local open = false

			local function refresh()
				local h = math.min(#items * 24, 160)
				tween(list, {Size = UDim2.new(1, 0, 0, open and h or 0)}, tweenTime)
				arrow.Text = open and "▲" or "▼"
				if open then
					list.Visible = true
				else
					task.delay(tweenTime, function()
						if not open then list.Visible = false end
					end)
				end
			end

			button.MouseButton1Click:Connect(function()
				open = not open
				refresh()
			end)

			function dropdown_data:Add(n)
				local object_data = {}
				n = tostring(n or "Object")

				local item = Instance.new("TextButton")
				item.BackgroundColor3 = Theme.Bg2
				item.BorderSizePixel = 0
				item.Size = UDim2.new(1, 0, 0, 24)
				item.Font = Enum.Font.GothamSemibold
				item.Text = "  " .. n
				item.TextColor3 = Theme.Text
				item.TextSize = 13
				item.TextXAlignment = Enum.TextXAlignment.Left
				item.AutoButtonColor = false
				item.ZIndex = list.ZIndex + 1
				item.Parent = list

				item.MouseEnter:Connect(function()
					tween(item, {BackgroundColor3 = mainColor}, tweenTime)
				end)

				item.MouseLeave:Connect(function()
					tween(item, {BackgroundColor3 = Theme.Bg2}, tweenTime)
				end)

				item.MouseButton1Click:Connect(function()
					button.Text = "  " .. dropdown_name .. "  [ " .. n .. " ]"
					open = false
					refresh()
					pcall(callback, n)
				end)

				table.insert(items, item)
				refresh()

				function object_data:Remove()
					item:Destroy()
					for i, v in ipairs(items) do
						if v == item then
							table.remove(items, i)
							break
						end
					end
					refresh()
				end

				return item, object_data
			end

			return dropdown_data, holder
		end

		function tab_data:AddFolder(folder_name)
			local folder_data = {}
			folder_name = tostring(folder_name or "Folder")

			local container = Instance.new("Frame")
			container.BackgroundColor3 = Theme.Bg2
			container.BorderSizePixel = 0
			container.Size = UDim2.new(1, 0, 0, 30)
			container.ClipsDescendants = true
			container.ZIndex = page.ZIndex + 1
			container.Parent = page
			corner(container, 5)
			stroke(container, Theme.Line, 0.68, 1)

			local header = Instance.new("TextButton")
			header.BackgroundTransparency = 1
			header.Size = UDim2.new(1, 0, 0, 30)
			header.Font = Enum.Font.GothamBold
			header.Text = "  ▶  " .. folder_name
			header.TextColor3 = Theme.Text
			header.TextSize = 14
			header.TextXAlignment = Enum.TextXAlignment.Left
			header.AutoButtonColor = false
			header.ZIndex = container.ZIndex + 1
			header.Parent = container

			local objects = Instance.new("Frame")
			objects.BackgroundTransparency = 1
			objects.Position = UDim2.new(0, 10, 0, 36)
			objects.Size = UDim2.new(1, -10, 0, 0)
			objects.ZIndex = container.ZIndex + 1
			objects.Parent = container

			local objList = Instance.new("UIListLayout")
			objList.Padding = UDim.new(0, 6)
			objList.Parent = objects

			local opened = false

			local function refresh()
				local h = objList.AbsoluteContentSize.Y
				header.Text = "  " .. (opened and "▼" or "▶") .. "  " .. folder_name
				tween(container, {Size = UDim2.new(1, 0, 0, opened and (42 + h) or 30)}, tweenTime)
			end

			objList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refresh)

			header.MouseButton1Click:Connect(function()
				opened = not opened
				refresh()
			end)

			local folderTab = {}

			local function withParent(fn, ...)
				local old = page
				page = objects
				local result = {fn(tab_data, ...)}
				page = old
				refresh()
				return table.unpack(result)
			end

			function folderTab:AddLabel(...)
				return withParent(tab_data.AddLabel, ...)
			end
			function folderTab:AddButton(...)
				return withParent(tab_data.AddButton, ...)
			end
			function folderTab:AddSwitch(...)
				return withParent(tab_data.AddSwitch, ...)
			end
			function folderTab:AddTextBox(...)
				return withParent(tab_data.AddTextBox, ...)
			end
			function folderTab:AddSlider(...)
				return withParent(tab_data.AddSlider, ...)
			end
			function folderTab:AddDropdown(...)
				return withParent(tab_data.AddDropdown, ...)
			end

			function folder_data:Toggle()
				opened = not opened
				refresh()
			end

			return folderTab, container
		end

		function tab_data:AddColorPicker(callback)
			callback = typeof(callback) == "function" and callback or function() end

			local data = {}
			local row = makeButtonBase(page, 30, page.ZIndex + 1)

			local title = Instance.new("TextLabel")
			title.BackgroundTransparency = 1
			title.Position = UDim2.new(0, 8, 0, 0)
			title.Size = UDim2.new(1, -60, 1, 0)
			title.Font = Enum.Font.GothamSemibold
			title.Text = "Color Picker"
			title.TextColor3 = Theme.Text
			title.TextSize = 14
			title.TextXAlignment = Enum.TextXAlignment.Left
			title.ZIndex = row.ZIndex + 1
			title.Parent = row

			local sample = Instance.new("TextButton")
			sample.AnchorPoint = Vector2.new(1, 0.5)
			sample.Position = UDim2.new(1, -6, 0.5, 0)
			sample.Size = UDim2.new(0, 42, 0, 20)
			sample.BackgroundColor3 = mainColor
			sample.BorderSizePixel = 0
			sample.Text = ""
			sample.AutoButtonColor = false
			sample.ZIndex = row.ZIndex + 1
			sample.Parent = row
			corner(sample, 4)

			local colors = {
				Color3.fromRGB(255, 45, 88),
				Color3.fromRGB(165, 80, 255),
				Color3.fromRGB(70, 150, 255),
				Color3.fromRGB(55, 235, 150),
				Color3.fromRGB(255, 200, 55),
			}
			local idx = 1

			function data:Set(color)
				if typeof(color) ~= "Color3" then color = mainColor end
				sample.BackgroundColor3 = color
				pcall(callback, color)
			end

			sample.MouseButton1Click:Connect(function()
				idx += 1
				if idx > #colors then idx = 1 end
				data:Set(colors[idx])
			end)

			return data, row
		end

		function tab_data:AddConsole()
			local data = {}
			local box = Instance.new("TextBox")
			box.BackgroundColor3 = Theme.Bg2
			box.BorderSizePixel = 0
			box.Size = UDim2.new(1, 0, 0, 160)
			box.Font = Enum.Font.Code
			box.Text = ""
			box.PlaceholderText = "-- Console"
			box.PlaceholderColor3 = Theme.Muted
			box.TextColor3 = Theme.Text
			box.TextSize = 14
			box.TextXAlignment = Enum.TextXAlignment.Left
			box.TextYAlignment = Enum.TextYAlignment.Top
			box.MultiLine = true
			box.ClearTextOnFocus = false
			box.ZIndex = page.ZIndex + 1
			box.Parent = page
			corner(box, 5)
			stroke(box, Theme.Line, 0.68, 1)
			pad(box, 8, 8, 8, 8)

			function data:Set(text)
				box.Text = tostring(text or "")
			end

			function data:Get()
				return box.Text
			end

			return data, box
		end

		table.insert(window_data.Tabs, tab_data)
		if #window_data.Tabs == 1 then
			selectTab(tab_data)
		end

		return tab_data
	end

	window.Size = UDim2.new(0, minSize.X, 0, 0)
	tween(window, {Size = UDim2.new(0, minSize.X, 0, minSize.Y)}, 0.25)

	return window_data
end

return library
