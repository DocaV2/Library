				corner(opt, 8)

				local pad = Instance.new("UIPadding")
				pad.PaddingLeft = UDim.new(0, 12)
				pad.Parent = opt

				opt.MouseEnter:Connect(function()
					tween(opt, {BackgroundColor3 = options.main_color}, options.tween_time)
				end)

				opt.MouseLeave:Connect(function()
					tween(opt, {BackgroundColor3 = Theme.Card2}, options.tween_time)
				end)

				opt.MouseButton1Click:Connect(function()
					main.Text = dropdown_name .. "  [ " .. n .. " ]"
					open = false
					updateListSize()
					task.delay(options.tween_time, function()
						if not open then list.Visible = false end
					end)
					pcall(callback, n)
				end)

				table.insert(objects, opt)
				updateListSize()

				function object_data:Remove()
					opt:Destroy()
					updateListSize()
				end

				return opt, object_data
			end

			return dropdown_data, holder
		end

