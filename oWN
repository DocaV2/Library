local function tween(obj, props, time)
	pcall(function()
		TweenService:Create(
			obj,
			TweenInfo.new(time or 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			props
		):Play()
	end)
end

local function corner(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 12)
	c.Parent = obj
	return c
end

local function stroke(obj, color, transparency, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Red
	s.Transparency = transparency or 0.45
	s.Thickness = thickness or 1
	s.Parent = obj
	return s
end

local function gradient(obj, c1, c2, rot)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2)
	g.Rotation = rot or 0
	g.Parent = obj
	return g
end

local function makeIcon(parent, text, color, pos, size, textSize, z)
	local box = Instance.new("Frame")
	box.BackgroundColor3 = Color3.fromRGB(24, 20, 34)
	box.BorderSizePixel = 0
	box.Position = pos or UDim2.new(0, 0, 0, 0)
	box.Size = size or UDim2.new(0, 32, 0, 32)
	box.ZIndex = z or 6
	box.Parent = parent
	corner(box, 10)
	stroke(box, color, 0.55, 1)

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 1, 0)
	label.Font = Enum.Font.GothamBlack
	label.Text = text or "•"
	label.TextColor3 = color or Theme.Red
	label.TextSize = textSize or 18
	label.TextStrokeTransparency = 0.6
	label.ZIndex = (z or 6) + 1
	label.Parent = box

	return box, label
end

local function gMouse()
	local loc = UIS:GetMouseLocation()
	return Vector2.new(loc.X, loc.Y)
end

local function formatWindows()
	local padding = 20
	local x, y = 20, 20
	local rowHeight = 0

	for _, win in ipairs(WindowsFrame:GetChildren()) do
		if win:IsA("Frame") and win.Visible then
			local size = win.AbsoluteSize
			if x + size.X > WindowsFrame.AbsoluteSize.X then
				x = 20
				y += rowHeight + padding
				rowHeight = 0
			end

			tween(win, {Position = UDim2.new(0, x, 0, y)}, 0.25)
			x += size.X + padding
			rowHeight = math.max(rowHeight, size.Y)
		end
	end
end

UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == ui_options.toggle_key then
		root.Enabled = not root.Enabled
	end
end)

local library = {}
local windowCount = 0

function library:FormatWindows()
	formatWindows()
end

local function createRow(parent, height)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, height or 62)
	row.BackgroundColor3 = Theme.Card
	row.BorderSizePixel = 0
	row.ZIndex = parent.ZIndex + 1
	row.Parent = parent
	corner(row, 12)
	stroke(row, Theme.Line, 0.72, 1)

	row.MouseEnter:Connect(function()
		tween(row, {BackgroundColor3 = Theme.Card2}, 0.15)
	end)
	row.MouseLeave:Connect(function()
		tween(row, {BackgroundColor3 = Theme.Card}, 0.15)
	end)

	return row
end

local function attachDraggable(target, handle)
	local dragging = false
	local dragStart
	local startPos

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = target.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			target.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

