windowsFrame.BackgroundTransparency = 1
windowsFrame.Position = UDim2.new(0, 20, 0, 20)
windowsFrame.Size = UDim2.new(1, -40, 1, -40)
windowsFrame.Parent = root

local Theme = {
	Bg = Color3.fromRGB(21, 22, 26),
	Bg2 = Color3.fromRGB(28, 30, 36),
	Bg3 = Color3.fromRGB(35, 38, 46),
	Text = Color3.fromRGB(235, 238, 245),
	Muted = Color3.fromRGB(165, 170, 185),
	Line = Color3.fromRGB(55, 60, 72),
	White = Color3.fromRGB(255, 255, 255),
	Green = Color3.fromRGB(70, 220, 140),
	Red = Color3.fromRGB(255, 70, 105),
}

local function tween(obj, props, time)
	pcall(function()
		TweenService:Create(
			obj,
			TweenInfo.new(time or ui_options.tween_time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			props
		):Play()
	end)
end

local function corner(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 6)
	c.Parent = obj
	return c
end

local function stroke(obj, color, trans, thick)
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Line
	s.Transparency = trans or 0.35
	s.Thickness = thick or 1
	s.Parent = obj
	return s
end

local function pad(obj, l, r, t, b)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, l or 0)
	p.PaddingRight = UDim.new(0, r or 0)
	p.PaddingTop = UDim.new(0, t or 0)
	p.PaddingBottom = UDim.new(0, b or 0)
	p.Parent = obj
	return p
end

local function getMouse()
	local pos = UIS:GetMouseLocation()
	return Vector2.new(pos.X, pos.Y)
end

local function textWidth(text, size)
	local tmp = Instance.new("TextLabel")
	tmp.Font = Enum.Font.GothamSemibold
	tmp.TextSize = size or 14
	tmp.Text = tostring(text)
	tmp.Parent = root
	local w = tmp.TextBounds.X
	tmp:Destroy()
	return w
end

local function ripple(button)
	task.spawn(function()
		local circle = Instance.new("Frame")
		circle.BackgroundColor3 = Theme.White
		circle.BackgroundTransparency = 0.82
		circle.BorderSizePixel = 0
		circle.AnchorPoint = Vector2.new(0.5, 0.5)
		circle.Position = UDim2.new(0.5, 0, 0.5, 0)
		circle.Size = UDim2.new(0, 0, 0, 0)
		circle.ZIndex = button.ZIndex + 10
		circle.Parent = button
		corner(circle, 999)

		local final = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 1.5
		tween(circle, {Size = UDim2.new(0, final, 0, final), BackgroundTransparency = 1}, 0.4)
		task.wait(0.42)
		circle:Destroy()
	end)
end

UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == ui_options.toggle_key then
		root.Enabled = not root.Enabled
	end
end)

local library = {}
local windowCount = 0

function library:FormatWindows()
	local x, y = 20, 20
	local gap = 14
	for _, w in ipairs(windowsFrame:GetChildren()) do
		if w:IsA("Frame") then
			tween(w, {Position = UDim2.new(0, x, 0, y)}, 0.2)
			x += w.AbsoluteSize.X + gap
			if x > windowsFrame.AbsoluteSize.X - 250 then
				x = 20
				y += 90
			end
		end
	end
end

local function makeButtonBase(parent, height, z)
	local frame = Instance.new("Frame")
	frame.BackgroundColor3 = Theme.Bg2
	frame.BorderSizePixel = 0
	frame.Size = UDim2.new(1, 0, 0, height or 24)
	frame.ZIndex = z or 2
	frame.Parent = parent
	corner(frame, 5)
	stroke(frame, Theme.Line, 0.65, 1)
	return frame
end

local function dragify(frame, handle)
	local dragging = false
	local start
	local startPos

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			start = input.Position
			startPos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - start
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
end

