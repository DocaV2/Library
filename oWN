	titleLabel.TextSize = 14
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.ZIndex = bar.ZIndex + 1
	titleLabel.Parent = bar

	local close = Instance.new("TextButton")
	close.Name = "Close"
	close.BackgroundTransparency = 1
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -6, 0, 2)
	close.Size = UDim2.new(0, 24, 0, 24)
	close.Font = Enum.Font.GothamBlack
	close.Text = "×"
	close.TextColor3 = Theme.White
	close.TextSize = 17
	close.AutoButtonColor = false
	close.ZIndex = bar.ZIndex + 1
	close.Parent = bar

	local tabSelection = Instance.new("Frame")
	tabSelection.Name = "TabSelection"
	tabSelection.BackgroundColor3 = Color3.fromRGB(32, 34, 40)
	tabSelection.BorderSizePixel = 0
	tabSelection.Position = UDim2.new(0, 10, 0, 38)
	tabSelection.Size = UDim2.new(1, -20, 0, 28)
	tabSelection.Visible = false
	tabSelection.ZIndex = window.ZIndex + 2
