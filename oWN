		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			resizing = false
		end
	end)

	RunService.Heartbeat:Connect(function()
		if resizing and Window.Parent then
			local pos = gMouse()
			local x = math.max(pos.X - Window.AbsolutePosition.X, minSize.X)
			local y = math.max(pos.Y - Window.AbsolutePosition.Y, minSize.Y)
			tween(Window, {Size = UDim2.new(0, x, 0, y)}, options.tween_time)
		end
	end)

	local minimized = false
	local oldSize = Window.Size

	Minimize.MouseButton1Click:Connect(function()
		minimized = not minimized
		if minimized then
			oldSize = Window.Size
			TabSelection.Visible = false
			Tabs.Visible = false
			Footer.Visible = false
			Resizer.Active = false
			tween(Window, {Size = UDim2.new(0, Window.AbsoluteSize.X, 0, 114)}, options.tween_time)
			Status.Text = "Minimized"
		else
			tween(Window, {Size = oldSize}, options.tween_time)
			task.delay(options.tween_time, function()
				if not minimized then
					TabSelection.Visible = true
					Tabs.Visible = true
					Footer.Visible = true
					Resizer.Active = true
					Status.Text = "Ready"
				end
			end)
		end
	end)

