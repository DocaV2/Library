		while Window.Parent do
			local hue = (os.clock() * 0.08) % 1
			local c1 = Color3.fromHSV(hue, 0.82, 1)
			local c2 = Color3.fromHSV((hue + 0.12) % 1, 0.72, 1)
			TopLine.BackgroundColor3 = c1
			mainStroke.Color = c2
			RunService.RenderStepped:Wait()
		end
	end)

