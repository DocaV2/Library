local function _ppButton(parent, text, color, callback)
  local b = _ppCreate("TextButton", {
    AutoButtonColor = false,
    BackgroundColor3 = color or Speed_Library.PhotoPack.Theme.Card2,
    BorderSizePixel = 0,
    Font = Enum.Font.GothamBold,
