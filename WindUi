  barBack.Size = UDim2.new(1,-52,0,6)
  barBack.BackgroundColor3 = Color3.fromRGB(35,35,35)
  barBack.BorderSizePixel = 0
  barBack.Parent = card
  Instance.new("UICorner", barBack).CornerRadius = UDim.new(1,0)

  local bar = Instance.new("Frame")
