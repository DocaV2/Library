-- Utility: smooth color pulse for accent elements.
function Speed_Library:Pulse(object, colorA, colorB, time)
  if not object then return end
  time = time or 0.75
  task.spawn(function()
    local flip = false
    while object and object.Parent and not Speed_Library.Unloaded do
      flip = not flip
      local target = flip and (colorA or Custom.ColorRGB) or (colorB or Color3.fromRGB(255,255,255))
      local prop = object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") and "TextColor3" or "BackgroundColor3"
      pcall(function()
        Speed_Library:Tween(object, TweenInfo.new(time, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {[prop] = target})
      end)
      task.wait(time)
    end
  end)
end

