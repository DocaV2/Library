local tabs, currentTab = {}, nil
local function createPage(name)
    local page = create("ScrollingFrame", {BackgroundTransparency=1, Size=UDim2.new(1,0,1,0), CanvasSize=UDim2.new(0,0,0,0), ScrollBarThickness=3, Visible=false}, Pages)
    local layout = create("UIListLayout", {Padding=UDim.new(0,8), SortOrder=Enum.SortOrder.LayoutOrder}, page)
    create("UIPadding", {PaddingRight=UDim.new(0,5)}, page)
    connect(layout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
        page.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y+10)
    end)
    return page
end
local function addTab(name, icon)
    local page = createPage(name)
    local btn = create("TextButton", {Text=(icon or "◇").."  "..name, TextColor3=Doca.Theme.Text, Font=Enum.Font.GothamBold, TextSize=13, TextXAlignment=Enum.TextXAlignment.Left, AutoButtonColor=false, BackgroundColor3=Doca.Theme.Panel2, BackgroundTransparency=.92, Size=UDim2.new(1,0,0,34), ClipsDescendants=true}, Sidebar)
    corner(btn,7)
    local active = create("Frame", {BackgroundColor3=Doca.Theme.Accent, Size=UDim2.new(0,3,0,0), Position=UDim2.new(0,0,.5,0), AnchorPoint=Vector2.new(0,.5)}, btn)
    corner(active,8)
    tabs[name]={Button=btn, Page=page, Active=active}
    connect(btn.Activated,function()
        local m=LocalPlayer:GetMouse(); ripple(btn,m.X,m.Y)
        for n,t in pairs(tabs) do
            t.Page.Visible=false
            tween(t.Button,.2,{BackgroundTransparency=.92})
            tween(t.Active,.2,{Size=UDim2.new(0,3,0,0)})
        end
        page.Visible=true; PageTitle.Text=name; currentTab=name
        tween(btn,.2,{BackgroundTransparency=.72})
        tween(active,.25,{Size=UDim2.new(0,3,0,22)})
    end)
    if not currentTab then btn:Activate() end
    return page
end

local function section(page, title)
    local s = create("Frame", {BackgroundColor3=Doca.Theme.Panel, BackgroundTransparency=.12, Size=UDim2.new(1,0,0,44), ClipsDescendants=true}, page)
    corner(s,9); stroke(s,Doca.Theme.Accent,1,.75)
    local head = create("TextButton", {BackgroundTransparency=1, Text=title.."                                      ›", TextColor3=Doca.Theme.Text, Font=Enum.Font.GothamBold, TextSize=14, TextXAlignment=Enum.TextXAlignment.Left, Size=UDim2.new(1,0,0,44)}, s)
    create("UIPadding", {PaddingLeft=UDim.new(0,12)}, head)
    local body = create("Frame", {BackgroundTransparency=1, Position=UDim2.new(0,0,0,48), Size=UDim2.new(1,0,0,0)}, s)
    local lay = create("UIListLayout", {Padding=UDim.new(0,7), SortOrder=Enum.SortOrder.LayoutOrder}, body)
    create("UIPadding", {PaddingLeft=UDim.new(0,8), PaddingRight=UDim.new(0,8)}, body)
    local open=false
    local function update()
        local h=lay.AbsoluteContentSize.Y+56
        tween(s,.25,{Size=open and UDim2.new(1,0,0,h) or UDim2.new(1,0,0,44)})
        tween(body,.25,{Size=UDim2.new(1,0,0,lay.AbsoluteContentSize.Y)})
    end
    connect(lay:GetPropertyChangedSignal("AbsoluteContentSize"), update)
    connect(head.Activated,function() open=not open; head.Text=title..(open and "                                      ˅" or "                                      ›"); update() end)
    return body, function() open=true; update() end
end
