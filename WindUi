function Speed_Library.Ultra:Blur(enabled, size)
  if not self.Flags.Blur then return end
  local blur = Lighting:FindFirstChild("DocaV1_UltraBlur") or Instance.new("BlurEffect")
  blur.Name = "DocaV1_UltraBlur"
  blur.Parent = Lighting
  blur.Size = enabled and 0 or (size or 14)
  safeTween(blur, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = enabled and (size or 14) or 0})
  if not enabled then
    task.delay(0.3, function()
      if blur and blur.Parent and blur.Size <= 1 then blur:Destroy() end
    end)
