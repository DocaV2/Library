-- Wrap CreateWindow so new windows can auto-install all effects by passing:
-- {Rainbow = true, EverythingAnimated = true, Confetti = true}
local _Doca_OriginalCreateWindow = Speed_Library.CreateWindow
function Speed_Library:CreateWindow(Config)
  Config = Config or {}
  local tabs = _Doca_OriginalCreateWindow(self, Config)
  task.defer(function()
    local parent = RunService:IsStudio() and Player.PlayerGui or (gethui and gethui() or game:GetService("CoreGui"))
    local latestGui
    for _, gui in ipairs(parent:GetChildren()) do
      if gui:IsA("ScreenGui") and gui:FindFirstChild("DropShadowHolder", true) then
        latestGui = gui
      end
    end
    if latestGui then
      if Config.Rainbow or Config.RGB or Config.Theme == "Rainbow" then
        self:MakeEverythingRainbow(latestGui)
      end
      if Config.EverythingAnimated ~= false then
        if Speed_Library.Ultra and Speed_Library.Ultra.AnimateGuiTree then
          Speed_Library.Ultra:AnimateGuiTree(latestGui)
          Speed_Library.Ultra:FloatingParticles(latestGui, Config.Particles or 18)
        end
        for _, obj in ipairs(latestGui:GetDescendants()) do
          if (obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("ImageButton")) and obj.AbsoluteSize.X > 80 and obj.AbsoluteSize.Y > 25 then
            pcall(function() obj.ClipsDescendants = true end)
          end
        end
      end
      if Config.Confetti then
        self:ConfettiBurst(latestGui, 40)
      end
    end
  end)
  return tabs
end

