local function _ppParent()
  local ok, hui = pcall(function()
    if gethui then return gethui() end
  end)
  if ok and hui then return hui end
  local ok2, core = pcall(function()
    if cloneref then return cloneref(game:GetService("CoreGui")) end
  end)
  if ok2 and core then return core end
  return RunService:IsStudio() and Player:WaitForChild("PlayerGui") or game:GetService("CoreGui")
end

local function _ppCreate(className, props, parent)
  local obj = Instance.new(className)
  for k, v in pairs(props or {}) do
    if k ~= "Parent" then
      pcall(function() obj[k] = v end)
    end
  end
  obj.Parent = parent or props.Parent
  return obj
end

local function _ppCorner(parent, radius)
  local c = Instance.new("UICorner")
  c.CornerRadius = UDim.new(0, radius or 10)
  c.Parent = parent
  return c
end

local function _ppStroke(parent, color, thickness, transparency)
  local s = Instance.new("UIStroke")
  s.Color = color or Speed_Library.PhotoPack.Theme.Stroke
  s.Thickness = thickness or 1
  s.Transparency = transparency or 0.25
  s.Parent = parent
  return s
end

local function _ppGradient(parent, colors, rotation)
  local g = Instance.new("UIGradient")
