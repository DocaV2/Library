local function safeTween(obj, info, props)
  if not obj or not obj.Parent then return nil end
  local ok, tween = pcall(function()
    return TweenService:Create(obj, info, props)
  end)
  if ok and tween then
    tween:Play()
    return tween
  end
  return nil
