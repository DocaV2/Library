function Doca:Notify(title, text, kind, duration)
    kind = kind or "Info"
    duration = duration or 4
    local col = Doca.Theme.Blue
    if kind == "Success" then col = Doca.Theme.Green elseif kind == "Warning" then col = Doca.Theme.Yellow elseif kind == "Error" then col = Doca.Theme.Accent end
    local frame = create("Frame", {BackgroundColor3 = Color3.fromRGB(14,14,18), Size = UDim2.new(1,0,0,0), ClipsDescendants = true, ZIndex = 51}, NotifyHolder)
    corner(frame, 10); stroke(frame, col, 1, .25)
    local icon = create("TextLabel", {BackgroundTransparency=1, Text="●", TextColor3=col, Font=Enum.Font.GothamBold, TextSize=18, Position=UDim2.new(0,12,0,12), Size=UDim2.new(0,20,0,20), ZIndex=52}, frame)
    create("TextLabel", {BackgroundTransparency=1, Text=title, TextColor3=Doca.Theme.Text, Font=Enum.Font.GothamBold, TextSize=13, TextXAlignment=Enum.TextXAlignment.Left, Position=UDim2.new(0,40,0,9), Size=UDim2.new(1,-70,0,18), ZIndex=52}, frame)
    create("TextLabel", {BackgroundTransparency=1, Text=text, TextColor3=Doca.Theme.Muted, Font=Enum.Font.Gotham, TextSize=12, TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left, Position=UDim2.new(0,40,0,30), Size=UDim2.new(1,-55,0,30), ZIndex=52}, frame)
    local close = create("TextButton", {BackgroundTransparency=1, Text="×", TextColor3=Doca.Theme.Muted, Font=Enum.Font.GothamBold, TextSize=18, Position=UDim2.new(1,-32,0,8), Size=UDim2.new(0,24,0,24), ZIndex=53}, frame)
    tween(frame,.25,{Size=UDim2.new(1,0,0,70)})
    local function remove()
        tween(frame,.2,{Size=UDim2.new(1,0,0,0), BackgroundTransparency=1})
        task.delay(.22,function() if frame then frame:Destroy() end end)
    end
    close.Activated:Connect(remove)
    task.delay(duration, remove)
end

local function ripple(btn, x, y)
    if Doca.FPSBoost then return end
    local r = create("Frame", {BackgroundColor3 = Color3.new(1,1,1), BackgroundTransparency = .72, AnchorPoint=Vector2.new(.5,.5), Position=UDim2.fromOffset(x-btn.AbsolutePosition.X, y-btn.AbsolutePosition.Y), Size=UDim2.fromOffset(0,0), ZIndex=btn.ZIndex+2}, btn)
    corner(r,999)
    local size = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y)*1.7
    tween(r,.45,{Size=UDim2.fromOffset(size,size), BackgroundTransparency=1})
    task.delay(.46,function() if r then r:Destroy() end end)
end

local function makeButton(parent, text, pos, size, color)
    local b = create("TextButton", {Text=text, TextColor3=Doca.Theme.Text, Font=Enum.Font.GothamBold, TextSize=13, AutoButtonColor=false, BackgroundColor3=color or Doca.Theme.Panel2, Position=pos, Size=size, ClipsDescendants=true}, parent)
    corner(b,8); local st=stroke(b,color or Doca.Theme.Accent,1,.45)
    connect(b.MouseEnter,function() tween(b,.15,{BackgroundTransparency=.05}); tween(st,.15,{Transparency=.1}) end)
    connect(b.MouseLeave,function() tween(b,.15,{BackgroundTransparency=0}); tween(st,.15,{Transparency=.45}) end)
    connect(b.Activated,function() local m=LocalPlayer:GetMouse(); ripple(b,m.X,m.Y) end)
    return b
end

local function draggable(handle, frame)
    local dragging, start, startPos
    connect(handle.InputBegan,function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; start = input.Position; startPos = frame.Position
        end
    end)
    connect(UserInputService.InputEnded,function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging=false end
    end)
    connect(UserInputService.InputChanged,function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d=input.Position-start
            tween(frame,.05,{Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)},Enum.EasingStyle.Linear)
        end
    end)
end

