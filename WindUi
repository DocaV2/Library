function Speed_Library.Ultra:AnimateGuiTree(root)
  if not root then return end
  for _, obj in ipairs(root:GetDescendants()) do
    if obj:IsA("TextButton") or obj:IsA("ImageButton") then
      if self.Flags.Hover then
        self:TrackConnection(obj.MouseEnter:Connect(function()
          self:Pop(obj, 1.025)
        end))
        self:TrackConnection(obj.MouseLeave:Connect(function()
          local scale = obj:FindFirstChild("DocaV1_UIScale")
          if scale then safeTween(scale, TweenInfo.new(0.12), {Scale = 1}) end
        end))
      end
      self:TrackConnection(obj.Activated:Connect(function()
        self:Pop(obj, 0.96)
        local mouse = Player:GetMouse()
        self:Ripple(obj, mouse.X, mouse.Y)
      end))
    elseif obj:IsA("Frame") and (obj.Name == "Main" or obj.Name == "SectionReal" or obj.Name == "Toggle" or obj.Name == "Button" or obj.Name == "Slider") then
      if not obj:FindFirstChild("DocaV1_Glow") then
