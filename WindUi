--[[
    DocaRedUI Library
    Black/Red glass UI library inspired by the provided screenshot.
    Made for normal Roblox LocalScript UI usage.

    Usage:
    local DocaRedUI = loadstring(game:HttpGet("YOUR_RAW_LINK"))()
    local Window = DocaRedUI:CreateWindow({...})
]]

local DocaRedUI = {}
DocaRedUI.__index = DocaRedUI

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

local Theme = {
    Background = Color3.fromRGB(9, 9, 11),
    Panel = Color3.fromRGB(14, 14, 17),
    Card = Color3.fromRGB(32, 17, 19),
    CardHover = Color3.fromRGB(45, 19, 22),
    Red = Color3.fromRGB(255, 55, 55),
    RedDark = Color3.fromRGB(100, 20, 24),
    Text = Color3.fromRGB(255, 255, 255),
    SubText = Color3.fromRGB(180, 180, 185),
    Muted = Color3.fromRGB(115, 115, 120),
    Stroke = Color3.fromRGB(60, 28, 31)
}

local Icons = {
    ["house"] = "⌂",
    ["home"] = "⌂",
    ["sprout"] = "♧",
    ["torii-gate"] = "冊",
    ["zap"] = "⚡",
    ["shield"] = "♢",
    ["paw-print"] = "♣",
    ["user"] = "♙",
    ["settings"] = "⚙",
    ["gem"] = "◇",
    ["lock"] = "▣",
    ["external-link"] = "↗",
    ["minus"] = "−",
    ["x"] = "×",
    ["maximize"] = "⛶",
    ["door-open"] = "冊"
}

local function New(class, props, children)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    for _, child in pairs(children or {}) do
        child.Parent = obj
    end
    return obj
end

local function Corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 16)
    c.Parent = obj
    return c
end

local function Stroke(obj, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Theme.Stroke
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0.45
    s.Parent = obj
    return s
end

local function Padding(obj, l, r, t, b)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, l or 0)
    p.PaddingRight = UDim.new(0, r or l or 0)
    p.PaddingTop = UDim.new(0, t or l or 0)
    p.PaddingBottom = UDim.new(0, b or t or l or 0)
    p.Parent = obj
    return p
end

local function List(obj, dir, padding)
    local l = Instance.new("UIListLayout")
    l.FillDirection = dir or Enum.FillDirection.Vertical
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.Padding = UDim.new(0, padding or 8)
    l.Parent = obj
    return l
end

local function MakeText(parent, text, size, color, bold)
    return New("TextLabel", {
        Parent = parent,
        BackgroundTransparency = 1,
        Text = text or "",
        TextColor3 = color or Theme.Text,
        TextSize = size or 16,
        Font = bold and Enum.Font.GothamBold or Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        RichText = true
    })
end

local function Tween(obj, time, props)
    local t = TweenService:Create(obj, TweenInfo.new(time or 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function MakeDraggable(frame, dragArea)
    local dragging = false
    local dragStart, startPos

    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

function DocaRedUI:CreateWindow(config)
    config = config or {}

    local window = {}
    window.Tabs = {}
    window.CurrentTab = nil
    window.Visible = true

    local gui = New("ScreenGui", {
        Name = config.Folder or "DocaRedUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = LocalPlayer:WaitForChild("PlayerGui")
    })

    local main = New("Frame", {
        Name = "MainWindow",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = config.Size or UDim2.fromOffset(860, 620),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = config.Transparent and 0.08 or 0,
        Parent = gui
    })
    Corner(main, 24)
    Stroke(main, Theme.Stroke, 1.4, 0.28)

    local shadow = New("ImageLabel", {
        Parent = main,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 12),
        Size = UDim2.new(1, 70, 1, 70),
        Image = "rbxassetid://5028857084",
        ImageColor3 = Color3.fromRGB(0, 0, 0),
        ImageTransparency = 0.48,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(24, 24, 276, 276),
        ZIndex = -1
    })

    local top = New("Frame", {
        Name = "Topbar",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 96),
        Parent = main
    })

    local logo = New("Frame", {
        Parent = top,
        BackgroundColor3 = Color3.fromRGB(35, 18, 20),
        Position = UDim2.new(0, 20, 0, 18),
        Size = UDim2.fromOffset(62, 62)
    })
    Corner(logo, 14)
    Stroke(logo, Theme.Stroke, 1, 0.35)

    local logoText = MakeText(logo, Icons[config.Icon or "torii-gate"] or "冊", 36, Theme.Text, true)
    logoText.Size = UDim2.new(1, 0, 1, 0)
    logoText.TextXAlignment = Enum.TextXAlignment.Center

    local title = MakeText(top, config.Title or "Doca UI", 25, Theme.Text, true)
    title.Position = UDim2.new(0, 100, 0, 22)
    title.Size = UDim2.new(1, -310, 0, 32)
    title.Text = config.Title or "Doca UI"

    local redPart = title.Text:match("|(.+)")
    if redPart then
        local before = title.Text:gsub("|.+", "")
        title.Text = before .. '<font color="rgb(255,55,55)">' .. redPart .. '</font>'
    end

    local author = MakeText(top, config.Author or "", 15, Theme.SubText, false)
    author.Position = UDim2.new(0, 100, 0, 55)
    author.Size = UDim2.new(1, -310, 0, 24)

    local buttons = New("Frame", {
        Parent = top,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -20, 0, 28),
        Size = UDim2.fromOffset(165, 44)
    })
    List(buttons, Enum.FillDirection.Horizontal, 12)

    local function topButton(symbol, cb)
        local b = New("TextButton", {
            Parent = buttons,
            BackgroundColor3 = Color3.fromRGB(19, 19, 22),
            Size = UDim2.fromOffset(44, 44),
            Text = symbol,
            TextColor3 = Theme.Red,
            TextSize = 27,
            Font = Enum.Font.GothamBold,
            AutoButtonColor = false
        })
        Corner(b, 12)
        Stroke(b, Theme.Stroke, 1, 0.5)
        b.MouseEnter:Connect(function() Tween(b, 0.15, {BackgroundColor3 = Color3.fromRGB(35, 18, 20)}) end)
        b.MouseLeave:Connect(function() Tween(b, 0.15, {BackgroundColor3 = Color3.fromRGB(19, 19, 22)}) end)
        b.MouseButton1Click:Connect(cb)
        return b
    end

    topButton("−", function()
        window:Toggle()
    end)

    topButton("⛶", function()
        if main.Size.X.Offset < 1000 then
            Tween(main, 0.25, {Size = UDim2.fromOffset(1000, 680)})
        else
            Tween(main, 0.25, {Size = config.Size or UDim2.fromOffset(860, 620)})
        end
    end)

    topButton("×", function()
        gui:Destroy()
    end)

    local sidebar = New("Frame", {
        Name = "Sidebar",
        Parent = main,
        Position = UDim2.new(0, 20, 0, 118),
        Size = UDim2.new(0, 250, 1, -140),
        BackgroundColor3 = Theme.Panel,
        BackgroundTransparency = 0.16
    })
    Corner(sidebar, 16)
    Stroke(sidebar, Theme.Stroke, 1, 0.55)
    Padding(sidebar, 18, 18, 20, 20)
    local sideList = List(sidebar, Enum.FillDirection.Vertical, 10)

    local pages = New("Frame", {
        Name = "Pages",
        Parent = main,
        Position = UDim2.new(0, 292, 0, 118),
        Size = UDim2.new(1, -315, 1, -140),
        BackgroundTransparency = 1
    })

    function window:Toggle()
        self.Visible = not self.Visible
        main.Visible = self.Visible
    end

    function window:SectionLabel(text)
        local label = MakeText(sidebar, string.upper(text or "SECTION"), 13, Theme.Muted, true)
        label.Size = UDim2.new(1, 0, 0, 28)
        label.TextXAlignment = Enum.TextXAlignment.Left
        return label
    end

    function window:Tab(tabConfig)
        tabConfig = tabConfig or {}

        local tab = {}
        tab.Title = tabConfig.Title or "Tab"

        local button = New("TextButton", {
            Parent = sidebar,
            Size = UDim2.new(1, 0, 0, 52),
            BackgroundColor3 = Theme.Panel,
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false
        })
        Corner(button, 10)

        local accent = New("Frame", {
            Parent = button,
            BackgroundColor3 = Theme.Red,
            Size = UDim2.new(0, 4, 1, -12),
            Position = UDim2.new(0, 0, 0, 6),
            Visible = false
        })
        Corner(accent, 4)

        local icon = MakeText(button, Icons[tabConfig.Icon or "house"] or "•", 25, Theme.SubText, true)
        icon.Position = UDim2.new(0, 18, 0, 0)
        icon.Size = UDim2.new(0, 30, 1, 0)
        icon.TextXAlignment = Enum.TextXAlignment.Center

        local label = MakeText(button, tab.Title, 18, Theme.Text, true)
        label.Position = UDim2.new(0, 60, 0, 0)
        label.Size = UDim2.new(1, -65, 1, 0)

        local page = New("Frame", {
            Parent = pages,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Visible = false
        })

        local headerIcon = New("Frame", {
            Parent = page,
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(74, 74),
            Position = UDim2.new(0, 18, 0, 18)
        })

        local ring = New("Frame", {
            Parent = headerIcon,
            BackgroundColor3 = Color3.fromRGB(40, 18, 20),
            Size = UDim2.new(1, 0, 1, 0)
        })
        Corner(ring, 100)
        Stroke(ring, Theme.Red, 2, 0)

        local glow = New("ImageLabel", {
            Parent = ring,
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(1, 32, 1, 32),
            Image = "rbxassetid://5028857084",
            ImageColor3 = Theme.Red,
            ImageTransparency = 0.62,
            ScaleType = Enum.ScaleType.Slice,
            SliceCenter = Rect.new(24, 24, 276, 276)
        })

        local hiText = MakeText(ring, Icons[tabConfig.Icon or "house"] or "•", 36, Theme.Red, true)
        hiText.Size = UDim2.new(1, 0, 1, 0)
        hiText.TextXAlignment = Enum.TextXAlignment.Center

        local headerTitle = MakeText(page, tab.Title, 24, Theme.Text, true)
        headerTitle.Position = UDim2.new(0, 108, 0, 25)
        headerTitle.Size = UDim2.new(1, -120, 0, 32)

        local headerDesc = MakeText(page, tabConfig.Desc or "", 15, Theme.SubText, false)
        headerDesc.Position = UDim2.new(0, 108, 0, 58)
        headerDesc.Size = UDim2.new(1, -120, 0, 24)

        local content = New("ScrollingFrame", {
            Parent = page,
            Position = UDim2.new(0, 18, 0, 110),
            Size = UDim2.new(1, -36, 1, -120),
            BackgroundTransparency = 1,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = Theme.Red,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y
        })
        Padding(content, 0, 6, 0, 8)
        List(content, Enum.FillDirection.Vertical, 14)

        local function selectTab()
            for _, t in pairs(window.Tabs) do
                t.Page.Visible = false
                t.Button.BackgroundTransparency = 1
                t.Accent.Visible = false
                t.Icon.TextColor3 = Theme.SubText
                t.Label.TextColor3 = Theme.Text
            end
            page.Visible = true
            button.BackgroundTransparency = 0
            button.BackgroundColor3 = Color3.fromRGB(50, 21, 24)
            accent.Visible = true
            icon.TextColor3 = Theme.Red
            label.TextColor3 = Theme.Red
            window.CurrentTab = tab
        end

        button.MouseEnter:Connect(function()
            if window.CurrentTab ~= tab then
                Tween(button, 0.15, {BackgroundTransparency = 0.35, BackgroundColor3 = Color3.fromRGB(28, 18, 20)})
            end
        end)

        button.MouseLeave:Connect(function()
            if window.CurrentTab ~= tab then
                Tween(button, 0.15, {BackgroundTransparency = 1})
            end
        end)

        button.MouseButton1Click:Connect(selectTab)

        tab.Page = page
        tab.Button = button
        tab.Accent = accent
        tab.Icon = icon
        tab.Label = label
        tab.Content = content

        function tab:Section(sectionConfig)
            sectionConfig = sectionConfig or {}
            local section = {}

            local box = New("Frame", {
                Parent = content,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y
            })
            List(box, Enum.FillDirection.Vertical, 10)

            if sectionConfig.Title or sectionConfig.Name then
                local st = MakeText(box, sectionConfig.Title or sectionConfig.Name, 15, Theme.Muted, true)
                st.Size = UDim2.new(1, 0, 0, 24)
            end

            local function makeCard(titleText, descText, iconName)
                local card = New("TextButton", {
                    Parent = box,
                    Size = UDim2.new(1, 0, 0, 104),
                    BackgroundColor3 = Theme.Card,
                    BackgroundTransparency = 0.08,
                    Text = "",
                    AutoButtonColor = false
                })
                Corner(card, 15)
                Stroke(card, Theme.Red, 1.6, 0.35)

                local left = New("Frame", {
                    Parent = card,
                    BackgroundColor3 = Color3.fromRGB(52, 24, 26),
                    Position = UDim2.new(0, 24, 0.5, -34),
                    Size = UDim2.fromOffset(68, 68)
                })
                Corner(left, 14)
                Stroke(left, Theme.Stroke, 1, 0.45)

                local li = MakeText(left, Icons[iconName or "external-link"] or "↗", 32, Theme.Red, true)
                li.Size = UDim2.new(1, 0, 1, 0)
                li.TextXAlignment = Enum.TextXAlignment.Center

                local t = MakeText(card, titleText or "Element", 21, Theme.Text, true)
                t.Position = UDim2.new(0, 118, 0, 28)
                t.Size = UDim2.new(1, -170, 0, 28)

                local d = MakeText(card, descText or "", 15, Theme.SubText, false)
                d.Position = UDim2.new(0, 118, 0, 58)
                d.Size = UDim2.new(1, -170, 0, 24)

                local arrow = MakeText(card, "›", 36, Theme.Red, true)
                arrow.AnchorPoint = Vector2.new(1, 0.5)
                arrow.Position = UDim2.new(1, -28, 0.5, 0)
                arrow.Size = UDim2.fromOffset(22, 40)
                arrow.TextXAlignment = Enum.TextXAlignment.Center

                card.MouseEnter:Connect(function()
                    Tween(card, 0.14, {BackgroundColor3 = Theme.CardHover})
                end)
                card.MouseLeave:Connect(function()
                    Tween(card, 0.14, {BackgroundColor3 = Theme.Card})
                end)

                return card
            end

            function section:Button(cfg)
                cfg = cfg or {}
                local card = makeCard(cfg.Title or cfg.Name or "Button", cfg.Desc or "Click to run action", cfg.Icon or "external-link")
                card.MouseButton1Click:Connect(function()
                    if cfg.Callback then
                        task.spawn(cfg.Callback)
                    end
                end)
                return card
            end

            function section:Toggle(cfg)
                cfg = cfg or {}
                local state = cfg.Default or false
                local card = makeCard(cfg.Title or "Toggle", cfg.Desc or "Enable or disable function", cfg.Icon or "shield")

                local toggle = New("Frame", {
                    Parent = card,
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -26, 0.5, 0),
                    Size = UDim2.fromOffset(54, 28),
                    BackgroundColor3 = state and Theme.Red or Color3.fromRGB(40, 40, 44)
                })
                Corner(toggle, 20)

                local knob = New("Frame", {
                    Parent = toggle,
                    Position = state and UDim2.new(1, -25, 0.5, -11) or UDim2.new(0, 3, 0.5, -11),
                    Size = UDim2.fromOffset(22, 22),
                    BackgroundColor3 = Theme.Text
                })
                Corner(knob, 20)

                local arrow = card:FindFirstChildWhichIsA("TextLabel", true)
                for _, child in pairs(card:GetChildren()) do
                    if child:IsA("TextLabel") and child.Text == "›" then child.Visible = false end
                end

                local function update()
                    Tween(toggle, 0.16, {BackgroundColor3 = state and Theme.Red or Color3.fromRGB(40, 40, 44)})
                    Tween(knob, 0.16, {Position = state and UDim2.new(1, -25, 0.5, -11) or UDim2.new(0, 3, 0.5, -11)})
                    if cfg.Callback then task.spawn(cfg.Callback, state) end
                end

                card.MouseButton1Click:Connect(function()
                    state = not state
                    update()
                end)

                return {
                    Set = function(_, v) state = v update() end,
                    Get = function() return state end
                }
            end

            function section:Input(cfg)
                cfg = cfg or {}
                local card = makeCard(cfg.Title or "Input", cfg.Desc or "Enter value", cfg.Icon or "external-link")
                card.Size = UDim2.new(1, 0, 0, 126)

                local boxInput = New("TextBox", {
                    Parent = card,
                    Position = UDim2.new(0, 118, 0, 82),
                    Size = UDim2.new(1, -150, 0, 32),
                    BackgroundColor3 = Color3.fromRGB(18, 18, 22),
                    Text = tostring(cfg.Value or ""),
                    PlaceholderText = cfg.Placeholder or "Input...",
                    TextColor3 = Theme.Text,
                    PlaceholderColor3 = Theme.Muted,
                    TextSize = 14,
                    Font = Enum.Font.GothamMedium,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = false
                })
                Corner(boxInput, 8)
                Stroke(boxInput, Theme.Stroke, 1, 0.5)
                Padding(boxInput, 10, 10, 0, 0)

                boxInput.FocusLost:Connect(function()
                    if cfg.Callback then task.spawn(cfg.Callback, boxInput.Text) end
                end)

                return boxInput
            end

            function section:Dropdown(cfg)
                cfg = cfg or {}
                local selected = cfg.Value or (cfg.Values and cfg.Values[1]) or "None"
                local card = makeCard(cfg.Title or "Dropdown", tostring(selected), cfg.Icon or "external-link")
                local descLabel
                for _, child in pairs(card:GetChildren()) do
                    if child:IsA("TextLabel") and child.Text == tostring(selected) then
                        descLabel = child
                    end
                end

                local open = false
                local listFrame = New("Frame", {
                    Parent = box,
                    Size = UDim2.new(1, 0, 0, 0),
                    BackgroundTransparency = 1,
                    ClipsDescendants = true
                })
                List(listFrame, Enum.FillDirection.Vertical, 6)

                local function rebuild()
                    for _, c in pairs(listFrame:GetChildren()) do
                        if c:IsA("TextButton") then c:Destroy() end
                    end
                    for _, val in pairs(cfg.Values or {}) do
                        local opt = New("TextButton", {
                            Parent = listFrame,
                            Size = UDim2.new(1, 0, 0, 38),
                            BackgroundColor3 = Color3.fromRGB(22, 15, 17),
                            Text = tostring(val),
                            TextColor3 = Theme.Text,
                            TextSize = 15,
                            Font = Enum.Font.GothamMedium,
                            AutoButtonColor = false
                        })
                        Corner(opt, 10)
                        Stroke(opt, Theme.Stroke, 1, 0.65)
                        opt.MouseButton1Click:Connect(function()
                            selected = val
                            if descLabel then descLabel.Text = tostring(val) end
                            open = false
                            Tween(listFrame, 0.15, {Size = UDim2.new(1, 0, 0, 0)})
                            if cfg.Callback then task.spawn(cfg.Callback, val) end
                        end)
                    end
                end
                rebuild()

                card.MouseButton1Click:Connect(function()
                    open = not open
                    local h = open and math.min(#(cfg.Values or {}) * 44, 220) or 0
                    Tween(listFrame, 0.15, {Size = UDim2.new(1, 0, 0, h)})
                end)

                return {
                    Get = function() return selected end
                }
            end

            function section:Paragraph(cfg)
                cfg = cfg or {}
                local card = makeCard(cfg.Title or "Paragraph", cfg.Desc or cfg.Content or "", cfg.Icon or "external-link")
                card.AutoButtonColor = false
                return card
            end

            return section
        end

        function tab:Button(cfg)
            local s = tab:Section({})
            return s:Button(cfg)
        end
        function tab:Toggle(cfg)
            local s = tab:Section({})
            return s:Toggle(cfg)
        end
        function tab:Input(cfg)
            local s = tab:Section({})
            return s:Input(cfg)
        end
        function tab:Dropdown(cfg)
            local s = tab:Section({})
            return s:Dropdown(cfg)
        end
        function tab:Paragraph(cfg)
            local s = tab:Section({})
            return s:Paragraph(cfg)
        end

        table.insert(window.Tabs, tab)
        if not window.CurrentTab then
            selectTab()
        end

        return tab
    end

    MakeDraggable(main, top)

    return window
end

return DocaRedUI
