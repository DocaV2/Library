function Speed_Library:AddNeonSweep(parent)
  if not parent then return end
  local sweep = Instance.new("Frame")
  sweep.Name = "DocaV1_NeonSweep"
  sweep.AnchorPoint = Vector2.new(0.5, 0.5)
  sweep.BackgroundColor3 = Color3.fromRGB(255,255,255)
  sweep.BackgroundTransparency = 0.8
  sweep.BorderSizePixel = 0
  sweep.Rotation = 18
  sweep.Size = UDim2.new(0, 42, 1.8, 0)
  sweep.Position = UDim2.new(-0.25, 0, 0.5, 0)
  sweep.ZIndex = (parent.ZIndex or 1) + 5
  sweep.Parent = parent
  Instance.new("UICorner", sweep).CornerRadius = UDim.new(1, 0)
  self:AddRainbowGradient(sweep, 90)
  local function run()
    if not sweep or not sweep.Parent then return end
    sweep.Position = UDim2.new(-0.25, 0, 0.5, 0)
    local tw = TweenService:Create(sweep, TweenInfo.new(1.35, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut), {Position = UDim2.new(1.25, 0, 0.5, 0)})
    tw:Play()
    tw.Completed:Once(function()
      task.delay(1.2, run)
    end)
  end
  task.delay(math.random() * 0.7, run)
  return sweep
end

function Speed_Library:AddBreathingGlow(parent, minT, maxT)
  local stroke = self:AddRainbowStroke(parent, 2)
  minT = minT or 0.12
  maxT = maxT or 0.72
  local alive = true
  local function breathe(on)
    if not alive or not stroke or not stroke.Parent then alive = false return end
    local tw = TweenService:Create(stroke, TweenInfo.new(0.85, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Transparency = on and minT or maxT})
    tw:Play()
    tw.Completed:Once(function() breathe(not on) end)
  end
  breathe(true)
  return stroke
end

function Speed_Library:AnimateTextRainbow(label)
  if not label then return end
  self:RegisterRainbowObject(label, "TextColor3")
  local stroke = label:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
  stroke.Thickness = 0.45
  stroke.Transparency = 0.35
  stroke.Parent = label
  self:RegisterRainbowObject(stroke, "Color", 0.35)
end

function Speed_Library:ConfettiBurst(parent, amount)
  amount = amount or 34
  if not parent then return end
  for i = 1, amount do
    local bit = Instance.new("Frame")
    bit.Name = "DocaV1_RGB_Confetti"
    bit.BorderSizePixel = 0
    bit.BackgroundColor3 = _rainbowNow(i / amount)
    bit.Size = UDim2.fromOffset(math.random(4, 8), math.random(4, 10))
    bit.AnchorPoint = Vector2.new(0.5,0.5)
    bit.Position = UDim2.new(0.5, 0, 0.5, 0)
    bit.Rotation = math.random(0, 360)
    bit.ZIndex = 999
    bit.Parent = parent
    local x = math.random(-180, 180)
    local y = math.random(-130, 130)
    TweenService:Create(bit, TweenInfo.new(math.random(45, 85) / 100, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
      Position = UDim2.new(0.5, x, 0.5, y),
      Rotation = bit.Rotation + math.random(120, 420),
      BackgroundTransparency = 1,
    }):Play()
    task.delay(0.95, function() if bit then bit:Destroy() end end)
  end
end

function Speed_Library:MakeEverythingRainbow(root)
  if not root then return end
  self:StartRainbow({Speed = 0.22, Saturation = 0.95, Value = 1})
  for _, obj in ipairs(root:GetDescendants()) do
    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
      if obj.Text ~= "" then self:AnimateTextRainbow(obj) end
    elseif obj:IsA("Frame") or obj:IsA("ImageButton") then
      if obj.BackgroundTransparency < 0.98 then
        self:AddBreathingGlow(obj, 0.18, 0.82)
        if obj.AbsoluteSize.X > 60 and obj.AbsoluteSize.Y > 24 then
          pcall(function() obj.ClipsDescendants = true end)
          self:AddNeonSweep(obj)
        end
      end
    elseif obj:IsA("UIStroke") then
      self:RegisterRainbowObject(obj, "Color")
    elseif obj:IsA("UIGradient") then
      self:RegisterRainbowGradient(obj)
    end
  end
end

function Speed_Library:InstallEverything(root, config)
  config = config or {}
  self:StartRainbow(config.Rainbow or {Speed = 0.22})
  if root then
    if Speed_Library.Ultra and Speed_Library.Ultra.AnimateGuiTree then
      Speed_Library.Ultra:AnimateGuiTree(root)
      Speed_Library.Ultra:FloatingParticles(root, config.Particles or 26)
    end
    self:MakeEverythingRainbow(root)
    self:ConfettiBurst(root, 28)
  end
end

