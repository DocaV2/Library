function Speed_Library.Ultra:Cleanup()
  for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
  for _, o in ipairs(self.Objects) do pcall(function() if o and o.Parent then o:Destroy() end end) end
  self.Connections = {}
  self.Objects = {}
  pcall(function()
    local blur = Lighting:FindFirstChild("DocaV1_UltraBlur")
    if blur then blur:Destroy() end
