  table.clear(__DocaConnections)
  for _, gui in ipairs(__DocaWindows) do
    if gui and gui.Parent then pcall(function() gui:Destroy() end) end
  end
  table.clear(__DocaWindows)
end

-- Queue wrapper: prevents notification spam from stacking badly.
local __OldNotification = Speed_Library.SetNotification
function Speed_Library:SetNotification(Config)
  table.insert(__NotifyQueue, Config)
  if __NotifyBusy then return end
  __NotifyBusy = true
  task.spawn(function()
    while #__NotifyQueue > 0 do
      local nextCfg = table.remove(__NotifyQueue, 1)
      pcall(function()
        __OldNotification(self, nextCfg)
      end)
      task.wait(0.15)
    end
    __NotifyBusy = false
  end)
end

-- Window wrapper: tags windows, adds intro animation, auto keybind, mobile scale.
local __OldCreateWindow = Speed_Library.CreateWindow
function Speed_Library:CreateWindow(Config)
  Config = Config or {}
  local size = Config.SizeUi or Config[4] or UDim2.fromOffset(550, 315)

  if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
    Config.SizeUi = Config.MobileSizeUi or UDim2.fromOffset(
      math.min(520, workspace.CurrentCamera.ViewportSize.X - 22),
      math.min(360, workspace.CurrentCamera.ViewportSize.Y - 80)
    )
    Config[4] = Config.SizeUi
  else
    Config.SizeUi = size
    Config[4] = size
  end

  local before = {}
  local parent = RunService:IsStudio() and Player.PlayerGui or (gethui and gethui() or game:GetService("CoreGui"))
  for _, child in ipairs(parent:GetChildren()) do before[child] = true end

  local tabs = __OldCreateWindow(self, Config)

  for _, child in ipairs(parent:GetChildren()) do
    if not before[child] and child:IsA("ScreenGui") then
      child.Name = "DocaV1_AnimatedWindow"
      child.ResetOnSpawn = false
      child.IgnoreGuiInset = true
      table.insert(__DocaWindows, child)
      Speed_Library:BindToggleKey(child, Config.ToggleKey or Speed_Library.Config.ToggleKey)

      for _, obj in ipairs(child:GetDescendants()) do
        if obj.Name == "DropShadowHolder" and obj:IsA("Frame") then
          local originalSize = obj.Size
          obj.Size = UDim2.fromOffset(0, 0)
          obj.BackgroundTransparency = 1
          Speed_Library:Tween(obj, TweenInfo.new(0.36, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = originalSize})
        elseif obj:IsA("TextButton") or obj:IsA("ImageButton") then
          Speed_Library:AddHover(obj, {BackgroundTransparency = obj.BackgroundTransparency}, {BackgroundTransparency = math.clamp(obj.BackgroundTransparency - 0.04, 0, 1)})
        end
      end
    end
  end

  return tabs
end

