function Speed_Library.Ultra:FloatingParticles(parent, count)
  if not self.Flags.Particles then return end
  if not parent then return end
  count = count or 18
  local folder = Instance.new("Folder")
  folder.Name = "DocaV1_FloatingParticles"
  folder.Parent = parent
  self:TrackObject(folder)
  for i = 1, count do
    local dot = Instance.new("Frame")
    dot.Name = "Particle"
    dot.BorderSizePixel = 0
    dot.BackgroundColor3 = Custom.ColorRGB
    dot.BackgroundTransparency = math.random(45, 78) / 100
    dot.Size = UDim2.fromOffset(math.random(2, 5), math.random(2, 5))
    dot.Position = UDim2.fromScale(math.random(), math.random())
    dot.Parent = folder
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
