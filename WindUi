local function addSlider(parent, title, min, max, default, cb)
    local r=row(parent,58)
    create("TextLabel", {BackgroundTransparency=1, Text=title, TextColor3=Doca.Theme.Text, Font=Enum.Font.GothamBold, TextSize=13, TextXAlignment=Enum.TextXAlignment.Left, Position=UDim2.new(0,12,0,6), Size=UDim2.new(1,-80,0,20)}, r)
    local valueLabel=create("TextLabel", {BackgroundTransparency=1, Text=tostring(default), TextColor3=Doca.Theme.Text, Font=Enum.Font.GothamBold, TextSize=12, TextXAlignment=Enum.TextXAlignment.Right, Position=UDim2.new(1,-70,0,6), Size=UDim2.new(0,55,0,20)}, r)
    local bar=create("Frame", {BackgroundColor3=Color3.fromRGB(55,55,62), Position=UDim2.new(0,12,0,38), Size=UDim2.new(1,-24,0,5)}, r); corner(bar,999)
    local fill=create("Frame", {BackgroundColor3=Doca.Theme.Accent, Size=UDim2.new(0,0,1,0)}, bar); corner(fill,999)
    local dragging=false; local val=default or min
    local function setFromX(x)
        local p=math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
        val=math.floor((min+(max-min)*p)+.5)
        valueLabel.Text=tostring(val); tween(fill,.08,{Size=UDim2.new(p,0,1,0)})
        if cb then task.spawn(cb,val) end
    end
    connect(bar.InputBegan,function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=true; setFromX(i.Position.X) end end)
    connect(UserInputService.InputEnded,function() dragging=false end)
    connect(UserInputService.InputChanged,function(i) if dragging then setFromX(i.Position.X) end end)
    setFromX(bar.AbsolutePosition.X + ((val-min)/(max-min))*math.max(bar.AbsoluteSize.X,1))
end
