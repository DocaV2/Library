function Speed_Library.Ultra:Pop(obj, scaleAmount)
  if not obj or not obj.Parent then return end
  scaleAmount = scaleAmount or 1.06
  local scale = obj:FindFirstChild("DocaV1_UIScale") or Instance.new("UIScale")
  scale.Name = "DocaV1_UIScale"
  scale.Scale = 1
  scale.Parent = obj
  safeTween(scale, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = scaleAmount})
  task.delay(0.08, function()
    safeTween(scale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})
  end)
end

function Speed_Library.Ultra:Shake(obj, power, times)
  if not obj or not obj.Parent then return end
  power = power or 8
  times = times or 5
  local old = obj.Position
  task.spawn(function()
    for i = 1, times do
      if not obj or not obj.Parent then break end
      safeTween(obj, TweenInfo.new(0.035), {Position = old + UDim2.fromOffset((i % 2 == 0 and power or -power), 0)})
      task.wait(0.035)
    end
    safeTween(obj, TweenInfo.new(0.08), {Position = old})
  end)
end

