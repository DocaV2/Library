Speed_Library.Rainbow = Speed_Library.Rainbow or {
  Enabled = false,
  Speed = 0.18,
  Saturation = 0.9,
  Value = 1,
  Objects = {},
  Gradients = {},
  Connections = {},
}

local function _rainbowNow(offset)
  offset = offset or 0
  return Color3.fromHSV((os.clock() * Speed_Library.Rainbow.Speed + offset) % 1, Speed_Library.Rainbow.Saturation, Speed_Library.Rainbow.Value)
end

local function _safeAdd(list, obj, prop, offset)
  if obj and obj.Parent then
    table.insert(list, {Object = obj, Property = prop, Offset = offset or math.random()})
  end
end

function Speed_Library:RainbowColor(offset)
  return _rainbowNow(offset)
end

function Speed_Library:RegisterRainbowObject(obj, property, offset)
  _safeAdd(Speed_Library.Rainbow.Objects, obj, property or "BackgroundColor3", offset)
  return obj
end

function Speed_Library:RegisterRainbowGradient(gradient, offset)
  if gradient and gradient.Parent then
    table.insert(Speed_Library.Rainbow.Gradients, {Gradient = gradient, Offset = offset or math.random()})
  end
  return gradient
end

function Speed_Library:StartRainbow(config)
  config = config or {}
  Speed_Library.Rainbow.Enabled = true
  Speed_Library.Rainbow.Speed = config.Speed or Speed_Library.Rainbow.Speed or 0.18
  Speed_Library.Rainbow.Saturation = config.Saturation or 0.9
  Speed_Library.Rainbow.Value = config.Value or 1

  if Speed_Library.Rainbow._Connection then
    Speed_Library.Rainbow._Connection:Disconnect()
  end

  Speed_Library.Rainbow._Connection = RunService.RenderStepped:Connect(function(dt)
    local base = _rainbowNow(0)
    Custom.ColorRGB = base

    for i = #Speed_Library.Rainbow.Objects, 1, -1 do
      local item = Speed_Library.Rainbow.Objects[i]
      local obj = item.Object
      if not obj or not obj.Parent then
        table.remove(Speed_Library.Rainbow.Objects, i)
      else
        pcall(function()
          obj[item.Property] = _rainbowNow(item.Offset)
        end)
      end
    end

    for i = #Speed_Library.Rainbow.Gradients, 1, -1 do
      local item = Speed_Library.Rainbow.Gradients[i]
      local g = item.Gradient
      if not g or not g.Parent then
        table.remove(Speed_Library.Rainbow.Gradients, i)
      else
        local o = item.Offset
        pcall(function()
          g.Rotation = (g.Rotation + dt * 85) % 360
          g.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, _rainbowNow(o)),
            ColorSequenceKeypoint.new(0.33, _rainbowNow(o + 0.18)),
            ColorSequenceKeypoint.new(0.66, _rainbowNow(o + 0.36)),
            ColorSequenceKeypoint.new(1, _rainbowNow(o + 0.54)),
          })
        end)
      end
    end
  end)

  if Speed_Library.Ultra and Speed_Library.Ultra.TrackConnection then
    Speed_Library.Ultra:TrackConnection(Speed_Library.Rainbow._Connection)
  end
end

function Speed_Library:StopRainbow()
  Speed_Library.Rainbow.Enabled = false
  if Speed_Library.Rainbow._Connection then
    Speed_Library.Rainbow._Connection:Disconnect()
    Speed_Library.Rainbow._Connection = nil
  end
end

