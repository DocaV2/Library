-- Better ripple: no manual wait loop, uses Debris-style destroy.
local OldCircleClick = CircleClick
function CircleClick(Button, X, Y)
  if not Speed_Library.Config.Ripple or Speed_Library.Config.LowPerformanceMode then return end
  if not Button or not Button.Parent then return end
  Button.ClipsDescendants = true

  local Circle = Instance.new("ImageLabel")
  Circle.Name = "DocaRipple"
  Circle.Image = "rbxassetid://106471194043211"
  Circle.ImageColor3 = Custom.ColorRGB
  Circle.ImageTransparency = 0.78
  Circle.BackgroundTransparency = 1
  Circle.ZIndex = 100
  Circle.Parent = Button

  local size = math.max(Button.AbsoluteSize.X, Button.AbsoluteSize.Y) * 1.75
  local posX = (X or 0) - Button.AbsolutePosition.X
  local posY = (Y or 0) - Button.AbsolutePosition.Y
  Circle.Position = UDim2.fromOffset(posX, posY)
  Circle.Size = UDim2.fromOffset(0, 0)

  local tw = Speed_Library:Tween(Circle, TweenInfo.new(0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
    Size = UDim2.fromOffset(size, size),
    Position = UDim2.new(0.5, -size / 2, 0.5, -size / 2),
    ImageTransparency = 1
  })
  if tw then
    tw.Completed:Connect(function()
      if Circle then Circle:Destroy() end
    end)
  else
    Circle:Destroy()
  end
end

function Speed_Library:AddHover(object, normalProps, hoverProps)
  if not object then return end
  Speed_Library:Connect(object.MouseEnter, function()
    Speed_Library:Tween(object, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), hoverProps)
  end)
  Speed_Library:Connect(object.MouseLeave, function()
    Speed_Library:Tween(object, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), normalProps)
  end)
end

function Speed_Library:BindToggleKey(screenGui, keyCode)
  keyCode = keyCode or Speed_Library.Config.ToggleKey
  if not screenGui then return end
  Speed_Library:Connect(UserInputService.InputBegan, function(input, processed)
    if processed then return end
    if input.KeyCode == keyCode then
      screenGui.Enabled = not screenGui.Enabled
    end
  end)
end

function Speed_Library:UnloadAll()
  Speed_Library.Unloaded = true
  for _, con in ipairs(__DocaConnections) do
    pcall(function() con:Disconnect() end)
