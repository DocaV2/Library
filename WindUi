    ClipsDescendants = true
  }, parent)
  _ppCorner(b, 7)
  _ppStroke(b, color or Speed_Library.PhotoPack.Theme.Stroke, 1, 0.25)
  b.MouseEnter:Connect(function()
    TweenService:Create(b, TweenInfo.new(0.16, Enum.EasingStyle.Quad), {BackgroundTransparency = 0.08, Size = b.Size + UDim2.fromOffset(2, 1)}):Play()
  end)
  b.MouseLeave:Connect(function()
    TweenService:Create(b, TweenInfo.new(0.16, Enum.EasingStyle.Quad), {BackgroundTransparency = 0, Size = b.Size - UDim2.fromOffset(2, 1)}):Play()
  end)
  b.Activated:Connect(function()
    if Speed_Library.Ultra and Speed_Library.Ultra.Ripple then
      local mouse = Player:GetMouse()
      Speed_Library.Ultra:Ripple(b, mouse.X, mouse.Y, Color3.fromRGB(255,255,255))
    end
    TweenService:Create(b, TweenInfo.new(0.08, Enum.EasingStyle.Back), {Rotation = 1}):Play()
    task.delay(0.08, function() if b.Parent then TweenService:Create(b, TweenInfo.new(0.12), {Rotation = 0}):Play() end end)
