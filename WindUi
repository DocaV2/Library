local __NotifyQueue = {}
local __NotifyBusy = false

local function __safeInsert(tbl, value)
  tbl[#tbl + 1] = value
  return value
end

function Speed_Library:Connect(signal, callback)
  local con = signal:Connect(callback)
  return __safeInsert(__DocaConnections, con)
end

function Speed_Library:Tween(object, info, props)
  if not object or not object.Parent then return nil end
  if Speed_Library.Config.LowPerformanceMode then
    for k, v in pairs(props) do pcall(function() object[k] = v end) end
    return nil
  end
  if not Speed_Library.Config.Animations then
    for k, v in pairs(props) do pcall(function() object[k] = v end) end
    return nil
  end

  __DocaTweens[object] = __DocaTweens[object] or {}
  for prop in pairs(props) do
    local old = __DocaTweens[object][prop]
    if old then pcall(function() old:Cancel() end) end
  end

  local speed = math.max(0.05, tonumber(Speed_Library.Config.AnimationSpeed) or 1)
  local tweenInfo = TweenInfo.new(
    math.max(0.01, info.Time / speed),
    info.EasingStyle,
    info.EasingDirection,
    info.RepeatCount,
    info.Reverses,
    info.DelayTime
  )
  local tween = TweenService:Create(object, tweenInfo, props)
  for prop in pairs(props) do __DocaTweens[object][prop] = tween end
  tween:Play()
  return tween
end

function Speed_Library:SetTheme(themeName)
  local theme = Speed_Library.Themes[themeName] or Speed_Library.Themes.DocaRed
  Speed_Library.Config.Theme = themeName
  Custom.ColorRGB = theme.Accent

  for _, gui in ipairs(__DocaWindows) do
    if gui and gui.Parent then
      for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("UIStroke") and obj.Color == Custom.ColorRGB then
          obj.Color = theme.Accent
        elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
          if obj.TextColor3 == Custom.ColorRGB then obj.TextColor3 = theme.Accent end
        elseif obj:IsA("Frame") then
          if obj.BackgroundColor3 == Custom.ColorRGB then obj.BackgroundColor3 = theme.Accent end
        elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
          if obj.ImageColor3 == Custom.ColorRGB then obj.ImageColor3 = theme.Accent end
        end
      end
    end
  end
end

