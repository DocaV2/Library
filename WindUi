function Speed_Library.PhotoPack:Track(conn)
  table.insert(self.Connections, conn)
  return conn
end

function Speed_Library.PhotoPack:Cleanup()
  for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
  table.clear(self.Connections)
end

function Speed_Library.PhotoPack:RainbowBorder(frame, thickness)
  local stroke = frame:FindFirstChild("PhotoRainbowStroke") or Instance.new("UIStroke")
  stroke.Name = "PhotoRainbowStroke"
  stroke.Thickness = thickness or 1.5
  stroke.Transparency = 0
  stroke.Parent = frame
  if Speed_Library.RegisterRainbowObject then Speed_Library:RegisterRainbowObject(stroke, "Color", math.random()) end
  return stroke
end

function Speed_Library.PhotoPack:AnimatedGradient(frame, rotation)
  local g = frame:FindFirstChild("PhotoRGBGradient") or _ppGradient(frame, {
    ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 70)),
    ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 0)),
    ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 230, 90)),
    ColorSequenceKeypoint.new(0.75, Color3.fromRGB(0, 170, 255)),
    ColorSequenceKeypoint.new(1.00, Color3.fromRGB(190, 0, 255))
  }, rotation or 0)
  g.Name = "PhotoRGBGradient"
  if Speed_Library.RegisterRainbowGradient then Speed_Library:RegisterRainbowGradient(g, math.random()) end
  return g
end

function Speed_Library.PhotoPack:Particles(parent, amount)
  amount = amount or 30
  local holder = _ppCreate("Folder", {Name = "PhotoParticles"}, parent)
  for i = 1, amount do
    local p = _ppCreate("Frame", {
      BackgroundColor3 = Color3.fromHSV(i / amount, 0.85, 1),
      BackgroundTransparency = math.random(20, 55) / 100,
      BorderSizePixel = 0,
      Position = UDim2.new(math.random(), 0, math.random(), 0),
      Size = UDim2.fromOffset(math.random(2, 5), math.random(2, 5)),
      ZIndex = 50
    }, holder)
    _ppCorner(p, 99)
    local function float()
      if not p.Parent then return end
      TweenService:Create(p, TweenInfo.new(math.random(30, 70) / 10, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
        Position = UDim2.new(math.random(), 0, math.random(), 0),
        BackgroundColor3 = Color3.fromHSV(math.random(), 0.85, 1),
        BackgroundTransparency = math.random(15, 70) / 100
      }):Play()
      task.delay(math.random(30, 70) / 10, float)
    end
    task.delay(math.random(), float)
  end
  return holder
end

