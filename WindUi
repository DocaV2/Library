function Speed_Library.PhotoPack:CreatePhotoMatchShowcase(config)
  config = config or {}
  if Speed_Library.StartRainbow then Speed_Library:StartRainbow({Speed = config.RainbowSpeed or 0.18, Saturation = 0.95, Value = 1}) end
  local gui = _ppCreate("ScreenGui", {Name = config.Name or "DocaV1_PhotoMatch_Showcase", ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ResetOnSpawn = false}, _ppParent())
  local root = _ppCreate("Frame", {Name="Root", BackgroundColor3=Speed_Library.PhotoPack.Theme.Background, BorderSizePixel=0, Size=UDim2.fromOffset(1536,1180), Position=UDim2.new(.5,-768,.5,-590), ClipsDescendants=true}, gui)
  _ppCorner(root, 0)
  self:Particles(root, config.BackgroundParticles or 70)
  self:KeyAndLoader(root)
  self:MainDashboard(root)
  self:RightPanels(root)
  self:KillerPanel(root)
  self:MiddlePanels(root)
  self:GamePanels(root)
  self:EffectsBar(root)
  self:BottomBar(root)
  local scale = _ppCreate("UIScale", {Scale = config.Scale or math.min(workspace.CurrentCamera.ViewportSize.X / 1536, workspace.CurrentCamera.ViewportSize.Y / 1180, 1)}, root)
  self:Track(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
    if root.Parent then scale.Scale = config.Scale or math.min(workspace.CurrentCamera.ViewportSize.X / 1536, workspace.CurrentCamera.ViewportSize.Y / 1180, 1) end
  end))
  root.BackgroundTransparency = 1
  TweenService:Create(root, TweenInfo.new(.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundTransparency = 0}):Play()
  if Speed_Library.Ultra and Speed_Library.Ultra.AnimateGuiTree then
    task.defer(function() Speed_Library.Ultra:AnimateGuiTree(root) end)
  end
  return gui, root
end

function Speed_Library:CreatePhotoMatchShowcase(config)
  return Speed_Library.PhotoPack:CreatePhotoMatchShowcase(config)
end

function Speed_Library:InstallPhotoMatchOnGui(root, config)
  config = config or {}
  if not root then return end
  if Speed_Library.StartRainbow then Speed_Library:StartRainbow({Speed = config.RainbowSpeed or 0.18}) end
  Speed_Library.PhotoPack:RainbowBorder(root, config.BorderThickness or 1.5)
  Speed_Library.PhotoPack:Particles(root, config.Particles or 24)
  for _, obj in ipairs(root:GetDescendants()) do
    if obj:IsA("Frame") then
      if obj.BackgroundTransparency < .96 then
        Speed_Library.PhotoPack:RainbowBorder(obj, .8)
      end
    elseif obj:IsA("TextButton") then
      Speed_Library.PhotoPack:RainbowBorder(obj, .7)
    elseif obj:IsA("TextLabel") and obj.Text ~= "" then
      if config.RainbowText ~= false and Speed_Library.RegisterRainbowObject then
        Speed_Library:RegisterRainbowObject(obj, "TextColor3", math.random())
      end
    elseif obj:IsA("UIStroke") and Speed_Library.RegisterRainbowObject then
      Speed_Library:RegisterRainbowObject(obj, "Color", math.random())
    elseif obj:IsA("UIGradient") and Speed_Library.RegisterRainbowGradient then
      Speed_Library:RegisterRainbowGradient(obj, math.random())
    end
  end
end

