local function addToggle(parent, title, default, cb)
    local r=row(parent,42)
    create("TextLabel", {BackgroundTransparency=1, Text=title, TextColor3=Doca.Theme.Text, Font=Enum.Font.GothamBold, TextSize=13, TextXAlignment=Enum.TextXAlignment.Left, Position=UDim2.new(0,12,0,0), Size=UDim2.new(1,-80,1,0)}, r)
    local bg=create("Frame", {BackgroundColor3=Color3.fromRGB(75,75,80), Position=UDim2.new(1,-58,.5,-10), Size=UDim2.fromOffset(42,20)}, r); corner(bg,999)
    local knob=create("Frame", {BackgroundColor3=Color3.fromRGB(240,240,240), Position=UDim2.new(0,2,.5,-8), Size=UDim2.fromOffset(16,16)}, bg); corner(knob,999)
    local btn=create("TextButton", {BackgroundTransparency=1, Text="", Size=UDim2.new(1,0,1,0)}, r)
    local val=default or false
    local function set(v)
        val=v
        tween(bg,.18,{BackgroundColor3=val and Doca.Theme.Accent or Color3.fromRGB(75,75,80)})
        tween(knob,.18,{Position=val and UDim2.new(1,-18,.5,-8) or UDim2.new(0,2,.5,-8)})
        if cb then task.spawn(cb,val) end
    end
    connect(btn.Activated,function() local m=LocalPlayer:GetMouse(); ripple(btn,m.X,m.Y); set(not val) end)
    set(val)
    return {Set=set, Get=function() return val end}
end
