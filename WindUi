  bar.BackgroundColor3 = Custom.ColorRGB
  bar.BorderSizePixel = 0
  bar.Parent = barBack
  Instance.new("UICorner", bar).CornerRadius = UDim.new(1,0)

  self:FloatingParticles(card, 16)
  self:Blur(true, 12)
  safeTween(bg, TweenInfo.new(0.18), {BackgroundTransparency = 0.18})
  safeTween(card, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(390,150)})
  safeTween(bar, TweenInfo.new(config.Duration or 1.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.fromScale(1,1)})

  task.delay((config.Duration or 1.45) + 0.2, function()
    safeTween(card, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.fromOffset(0,0)})
    safeTween(bg, TweenInfo.new(0.25), {BackgroundTransparency = 1})
    self:Blur(false, 12)
    task.wait(0.28)
    if gui then gui:Destroy() end
  end)
  return gui
end

function Speed_Library.Ultra:KeySystem(config)
  config = config or {}
  local correctKey = tostring(config.Key or config.CorrectKey or "DocaOnTop")
  local titleText = config.Title or "Doca V1 Key System"
  local subtitleText = config.Subtitle or "Enter key to unlock the UI"
  local fileName = config.FileName or "DocaV1_Key.txt"
  local onSuccess = config.Callback or config.OnSuccess or function() end
  local onFail = config.OnFail or function() end
  local saveKey = config.SaveKey
  if saveKey == nil then saveKey = true end

  if saveKey and isfile and readfile then
    local ok, saved = pcall(function() return readfile(fileName) end)
    if ok and tostring(saved) == correctKey then
      task.spawn(onSuccess)
      return true
    end
  end

  local gui = Instance.new("ScreenGui")
  gui.Name = "DocaV1_KeySystem"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
  protectGui(gui)
  gui.Parent = getParentGui()
  self:TrackObject(gui)

  local bg = Instance.new("Frame")
  bg.BackgroundColor3 = Color3.fromRGB(0,0,0)
  bg.BackgroundTransparency = 1
  bg.Size = UDim2.fromScale(1,1)
  bg.Parent = gui

  local card = Instance.new("Frame")
  card.AnchorPoint = Vector2.new(0.5,0.5)
  card.Position = UDim2.fromScale(0.5,0.5)
  card.Size = UDim2.fromOffset(0,0)
  card.BackgroundColor3 = Color3.fromRGB(13,13,13)
  card.BorderSizePixel = 0
  card.ClipsDescendants = true
  card.Parent = bg
  Instance.new("UICorner", card).CornerRadius = UDim.new(0,18)
  self:Glow(card, Custom.ColorRGB)
  self:FloatingParticles(card, 22)

  local title = Instance.new("TextLabel")
  title.BackgroundTransparency = 1
  title.Text = titleText
  title.Font = Enum.Font.GothamBlack
  title.TextSize = 24
  title.TextColor3 = Color3.fromRGB(255,255,255)
  title.Position = UDim2.fromOffset(20,22)
  title.Size = UDim2.new(1,-40,0,30)
  title.Parent = card

  local subtitle = Instance.new("TextLabel")
  subtitle.BackgroundTransparency = 1
  subtitle.Text = subtitleText
  subtitle.Font = Enum.Font.GothamBold
  subtitle.TextSize = 12
  subtitle.TextColor3 = Color3.fromRGB(150,150,150)
  subtitle.Position = UDim2.fromOffset(20,55)
  subtitle.Size = UDim2.new(1,-40,0,22)
  subtitle.Parent = card

  local box = Instance.new("TextBox")
  box.PlaceholderText = "Key here..."
  box.Text = ""
  box.ClearTextOnFocus = false
  box.Font = Enum.Font.GothamBold
  box.TextSize = 14
  box.TextColor3 = Color3.fromRGB(255,255,255)
  box.PlaceholderColor3 = Color3.fromRGB(95,95,95)
  box.BackgroundColor3 = Color3.fromRGB(25,25,25)
  box.BorderSizePixel = 0
  box.Position = UDim2.fromOffset(24,94)
  box.Size = UDim2.new(1,-48,0,42)
  box.Parent = card
  Instance.new("UICorner", box).CornerRadius = UDim.new(0,10)

  local unlock = Instance.new("TextButton")
  unlock.Text = "UNLOCK"
  unlock.Font = Enum.Font.GothamBlack
  unlock.TextSize = 14
  unlock.TextColor3 = Color3.fromRGB(255,255,255)
  unlock.BackgroundColor3 = Custom.ColorRGB
  unlock.BorderSizePixel = 0
  unlock.Position = UDim2.fromOffset(24,150)
  unlock.Size = UDim2.new(0.5,-30,0,40)
  unlock.Parent = card
  Instance.new("UICorner", unlock).CornerRadius = UDim.new(0,10)

  local getKey = Instance.new("TextButton")
  getKey.Text = "GET KEY"
  getKey.Font = Enum.Font.GothamBlack
  getKey.TextSize = 14
  getKey.TextColor3 = Color3.fromRGB(255,255,255)
  getKey.BackgroundColor3 = Color3.fromRGB(32,32,32)
  getKey.BorderSizePixel = 0
  getKey.Position = UDim2.new(0.5,6,0,150)
  getKey.Size = UDim2.new(0.5,-30,0,40)
  getKey.Parent = card
  Instance.new("UICorner", getKey).CornerRadius = UDim.new(0,10)

  local status = Instance.new("TextLabel")
  status.BackgroundTransparency = 1
  status.Text = ""
  status.Font = Enum.Font.GothamBold
  status.TextSize = 12
  status.TextColor3 = Color3.fromRGB(180,180,180)
  status.Position = UDim2.fromOffset(24,202)
  status.Size = UDim2.new(1,-48,0,18)
  status.Parent = card

  self:Blur(true, 15)
  safeTween(bg, TweenInfo.new(0.2), {BackgroundTransparency = 0.25})
  safeTween(card, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(430,238)})
  self:AnimateGuiTree(gui)

  local function closeAndSuccess()
    status.Text = "Correct key. Loading..."
    status.TextColor3 = Custom.ColorRGB
    if saveKey and writefile then pcall(function() writefile(fileName, correctKey) end) end
    safeTween(card, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.fromOffset(0,0)})
    safeTween(bg, TweenInfo.new(0.28), {BackgroundTransparency = 1})
    self:Blur(false, 15)
    task.delay(0.3, function()
      if gui then gui:Destroy() end
      onSuccess()
    end)
  end

  local function check()
    self:Pop(unlock, 0.96)
    if tostring(box.Text) == correctKey then
      closeAndSuccess()
    else
      status.Text = "Wrong key. Try again."
      status.TextColor3 = Color3.fromRGB(255,80,80)
      self:Shake(card, 10, 6)
      onFail(box.Text)
    end
  end

  self:TrackConnection(unlock.Activated:Connect(check))
  self:TrackConnection(box.FocusLost:Connect(function(enter)
    if enter then check() end
  end))
  self:TrackConnection(getKey.Activated:Connect(function()
    local text = config.KeyLink or config.CopyText or "DocaOnTop"
    if setclipboard then pcall(function() setclipboard(text) end) end
    status.Text = "Copied key/link."
    status.TextColor3 = Color3.fromRGB(210,210,210)
    self:Pop(getKey, 0.96)
  end))

  return false
end

function Speed_Library.Ultra:InstallToWindow(windowGui)
  if not windowGui then return end
  self:AnimateGuiTree(windowGui)
  self:FloatingParticles(windowGui, 14)
end

-- Public shortcuts.
function Speed_Library:CreateKeySystem(config)
  return Speed_Library.Ultra:KeySystem(config)
end

function Speed_Library:ShowLoader(config)
  return Speed_Library.Ultra:LoadingScreen(config)
end

function Speed_Library:InstallUltraAnimations(root)
  return Speed_Library.Ultra:InstallToWindow(root)
end

function Speed_Library:UltraCleanup()
  return Speed_Library.Ultra:Cleanup()
end


return Speed_Library
